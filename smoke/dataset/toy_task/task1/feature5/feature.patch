+"""URL slugs."""
+
+import re
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Lowercase, replace runs of non-alphanumeric characters with `sep`, strip leading/trailing `sep`."""
+    slug = re.sub(r"[^a-z0-9]+", sep, text.lower())
+    return slug.strip(sep)
