 class ToolCalls(Type):
+    @pydantic.model_validator(mode="before")
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize various LM output formats into the expected dict structure.
+
+        Supported input variations:
+        1. Dict with `tool_calls` key containing a list of tool call dicts.
+        2. Single tool call dict with `name` and `args` keys.
+        3. Bare list of tool call dicts.
+        4. JSON string representing any of the above.
+        Returns the normalized dict with a `tool_calls` list, or the original
+        non‑JSON string/value if parsing fails.
+        """
+        import json
+        # If already a ToolCalls instance, convert to dict via .model_dump() if needed
+        if isinstance(data, cls):
+            # Pydantic BaseModel provides model_dump
+            try:
+                return data.model_dump()
+            except Exception:
+                pass
+        # Handle JSON string input
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+            except Exception:
+                return data  # Return original string if not valid JSON
+            data = parsed
+        # If it's a dict
+        if isinstance(data, dict):
+            # Already in correct shape
+            if "tool_calls" in data and isinstance(data["tool_calls"], list):
+                return data
+            # Single object case
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+            # Unexpected dict, return as‑is
+            return data
+        # If it's a list (bare list of tool calls)
+        if isinstance(data, list):
+            return {"tool_calls": data}
+        # Fallback: return original value
+        return data
     class ToolCall(BaseModel):
         name: str
         args: dict[str, Any]
