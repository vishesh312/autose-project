+import pickle
+
+def dump(obj, file, *args, **kwargs):
+    return pickle.dump(obj, file, *args, **kwargs)
+
+def dumps(obj, *args, **kwargs):
+    return pickle.dumps(obj, *args, **kwargs)
+
+def load(file, *args, **kwargs):
+    return pickle.load(file, *args, **kwargs)
+
+def loads(data, *args, **kwargs):
+    return pickle.loads(data, *args, **kwargs)
+
+def __getattr__(name):
+    # Fallback to pickle attributes
+    return getattr(pickle, name)
