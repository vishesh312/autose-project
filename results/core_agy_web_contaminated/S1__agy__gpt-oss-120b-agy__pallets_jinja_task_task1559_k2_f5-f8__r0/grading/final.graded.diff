+class ConditionalI18nExtension(Extension):
+    """Conditional translation rendering with fallback support.
+
+    Syntax:
+        {% ctrans condition [variables] [trimmed|notrimmed] %}
+            ... singular block ...
+        {% pluralize [var] %}
+            ... plural block ...
+        {% fallback %}
+            ... fallback content ...
+        {% endctrans %}
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.Node:
+        lineno = next(parser.stream).lineno
+        # parse condition expression
+        condition = parser.parse_expression()
+        # parse optional variable declarations and trimming flags (similar to trans)
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if variables:
+                parser.stream.expect("comma")
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+        parser.stream.expect("block_end")
+
+        # Validation of variables (reuse same helpers as InternationalizationExtension)
+        self._validate_trans_variables(variables, parser, lineno)
+
+        # parse singular (and optional plural) as in trans
+        singular_names, singular = self._parse_block(parser, True)
+        referenced = set(singular_names)
+        plural_expr = None
+        plural = None
+        have_plural = False
+        num_called_num = False
+        if singular_names:
+            # default plural variable handling similar to trans
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            next(parser.stream)
+            referenced.update(plural_names)
+        else:
+            next(parser.stream)
+
+        # register free names as simple name expressions
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        # trimmed handling
+        if trimmed is None:
+            trimmed = self.environment.policies["ext.i18n.trimmed"]
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+
+        # expect fallback block
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block", parser.stream.current.lineno, exc=TemplateSyntaxError)
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback_content = self._parse_block(parser, False)
+        # consume endctrans
+        if not parser.stream.current.test("name:endctrans"):
+            parser.fail("unclosed conditional translation block", lineno, exc=TemplateSyntaxError)
+        next(parser.stream)
+
+        # Build translation node using existing logic
+        trans_node = self._make_node(
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(referenced),
+            num_called_num and have_plural,
+        )
+        trans_node.set_lineno(lineno)
+
+        # Build fallback node (no gettext)
+        # Register any fallback variables
+        for name in fallback_names:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+        vars_referenced_fb = bool(fallback_names)
+        if not vars_referenced_fb:
+            fallback_node = nodes.Output([nodes.Const(fallback_content)])
+        else:
+            fallback_node = nodes.Output([
+                nodes.Mod(
+                    nodes.Const(fallback_content),
+                    nodes.Dict([
+                        nodes.Pair(nodes.Const(key), variables[key])
+                        for key in fallback_names
+                    ]),
+                )
+            ])
+        # Apply autoescape handling similar to _make_node path for non‑newstyle
+        if not self.environment.newstyle_gettext:
+            fallback_node = nodes.MarkSafeIfAutoescape(fallback_node)
+        # Build conditional If node
+        if_node = nodes.If(condition, [trans_node], [], [fallback_node])
+        if_node.set_lineno(lineno)
+        return if_node
+
+    # Reuse existing helper methods from InternationalizationExtension
+    _parse_block = InternationalizationExtension._parse_block
+    _trim_whitespace = InternationalizationExtension._trim_whitespace
+    _make_node = InternationalizationExtension._make_node
+    _validate_trans_expression = InternationalizationExtension._validate_trans_expression
+    _validate_trans_variables = InternationalizationExtension._validate_trans_variables
+
