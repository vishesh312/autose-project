++        """Add or overwrite an alias.
++
++        Parameters
++        ----------
++        alias:
++            The name that will be used as an alternative reference.
++        target:
++            The actual template name that ``alias`` should resolve to.
++        """
++        self._aliases[alias] = target
++
++    def remove_alias(self, alias: str) -> None:
++        """Remove an alias if it exists.
++
++        This operation is safe to call with a non‑existent alias; it simply
++        does nothing.
++        """
++        self._aliases.pop(alias, None)
++
++    def _resolve_alias(self, name: str) -> str:
++        """Resolve *name* through the alias table.
++
++        Only a single level of indirection is applied – aliases are not
++        chained. If ``name`` is not an alias, it is returned unchanged.
++        """
++        return self._aliases.get(name, name)
