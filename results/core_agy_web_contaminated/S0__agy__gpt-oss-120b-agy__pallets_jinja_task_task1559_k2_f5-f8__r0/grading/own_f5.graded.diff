+    def _validate_trans_variables(self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int) -> None:
+        """Validate variable names and expressions used in a trans block.
+
+        Checks that variable names are valid Python identifiers, do not clash
+        with built‑in gettext function names, and that their associated
+        expressions are of an allowed type.
+        """
+        for name, expr in variables.items():
+            # Name must be a valid identifier
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r} in trans block, must be a valid Python identifier.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Name must not conflict with gettext function names
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Validate the expression associated with the name
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(self, name: str, expr: nodes.Expr, parser: "Parser", lineno: int) -> None:
+        """Validate a single expression used for a trans variable.
+
+        Allowed expression node types are ``Const``, ``Name``, ``Call`` with a
+        simple name as the callee, ``Getattr``, ``Filter`` and ``Test``.
+        """
+        allowed = (
+            nodes.Const,
+            nodes.Name,
+            nodes.Call,
+            nodes.Getattr,
+            nodes.Filter,
+            nodes.Test,
+        )
+        if isinstance(expr, nodes.Call):
+            # Ensure the call target is a simple name (no attribute accesses)
+            if not isinstance(expr.node, nodes.Name):
+                parser.fail(
+                    f"Invalid expression for variable {name!r}: call target must be a simple name.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+        if not isinstance(expr, allowed):
+            parser.fail(
+                f"Invalid expression type for variable {name!r} in trans block: {type(expr).__name__} is not allowed.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
     def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
         return _ws_re.sub(" ", string.strip())
 
