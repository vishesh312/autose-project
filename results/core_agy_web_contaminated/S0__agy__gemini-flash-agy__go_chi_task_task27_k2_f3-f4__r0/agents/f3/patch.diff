new file mode 100644
index 0000000..f68f379
--- /dev/null
+++ b/logging.go
@@ -0,0 +1,28 @@
+package chi
+
+import (
+	"fmt"
+	"os"
+)
+
+var (
+	// Debug level for logging, can be set at runtime
+	debugLogging = false
+)
+
+// EnableDebugLogging turns on debug-level logging
+func EnableDebugLogging() {
+	debugLogging = true
+}
+
+// logDebug logs debug information if debug logging is enabled
+func logDebug(format string, v ...interface{}) {
+	if debugLogging {
+		fmt.Fprintf(os.Stderr, "[CHI-DEBUG] "+format+"\n", v...)
+	}
+}
+
+// logError logs error information
+func logError(format string, v ...interface{}) {
+	fmt.Fprintf(os.Stderr, "[CHI-ERROR] "+format+"\n", v...)
+}
diff --git a/logging_test.go b/logging_test.go
new file mode 100644
index 0000000..44e2267
--- /dev/null
+++ b/logging_test.go
@@ -0,0 +1,132 @@
+package chi
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestDebugLogging(t *testing.T) {
+	// Save original stderr and restore it after the test
+	originalStderr := os.Stderr
+	defer func() { os.Stderr = originalStderr }()
+
+	// Create a pipe to capture stderr output
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("Failed to create pipe: %v", err)
+	}
+	os.Stderr = w
+
+	// Ensure debug logging is initially disabled
+	debugLogging = false
+
+	// This should not produce output
+	logDebug("This should not be logged")
+
+	// Enable debug logging and check for output
+	EnableDebugLogging()
+	if !debugLogging {
+		t.Error("Debug logging should be enabled")
+	}
+
+	// Log a test message
+	testMessage := "Test debug message"
+	logDebug(testMessage)
+
+	// Close write end of pipe to receive all output
+	w.Close()
+
+	// Read captured output
+	var buf bytes.Buffer
+	_, err = io.Copy(&buf, r)
+	if err != nil {
+		t.Fatalf("Failed to read from pipe: %v", err)
+	}
+
+	// Check if the debug message was logged
+	output := buf.String()
+	if !strings.Contains(output, testMessage) {
+		t.Errorf("Expected output to contain %q, but got %q", testMessage, output)
+	}
+	if !strings.Contains(output, "[CHI-DEBUG]") {
+		t.Errorf("Expected output to contain [CHI-DEBUG] prefix, but got %q", output)
+	}
+}
+
+func TestErrorLogging(t *testing.T) {
+	// Save original stderr and restore it after the test
+	originalStderr := os.Stderr
+	defer func() { os.Stderr = originalStderr }()
+
+	// Create a pipe to capture stderr output
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("Failed to create pipe: %v", err)
+	}
+	os.Stderr = w
+
+	// Log an error message
+	testMessage := "Test error message"
+	logError(testMessage)
+
+	// Close write end of pipe to receive all output
+	w.Close()
+
+	// Read captured output
+	var buf bytes.Buffer
+	_, err = io.Copy(&buf, r)
+	if err != nil {
+		t.Fatalf("Failed to read from pipe: %v", err)
+	}
+
+	// Check if the error message was logged
+	output := buf.String()
+	if !strings.Contains(output, testMessage) {
+		t.Errorf("Expected output to contain %q, but got %q", testMessage, output)
+	}
+	if !strings.Contains(output, "[CHI-ERROR]") {
+		t.Errorf("Expected output to contain [CHI-ERROR] prefix, but got %q", output)
+	}
+}
+
+func TestFormatLogging(t *testing.T) {
+	// Save original stderr and restore it after the test
+	originalStderr := os.Stderr
+	defer func() { os.Stderr = originalStderr }()
+
+	// Create a pipe to capture stderr output
+	r, w, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("Failed to create pipe: %v", err)
+	}
+	os.Stderr = w
+
+	// Enable debug logging
+	EnableDebugLogging()
+
+	// Test format string with arguments
+	method := "GET"
+	path := "/users/{id}"
+	expectedFormat := "Method: GET, Path: /users/{id}"
+
+	logDebug("Method: %s, Path: %s", method, path)
+
+	// Close write end of pipe to receive all output
+	w.Close()
+
+	// Read captured output
+	var buf bytes.Buffer
+	_, err = io.Copy(&buf, r)
+	if err != nil {
+		t.Fatalf("Failed to read from pipe: %v", err)
+	}
+
+	// Check if the formatted message was logged correctly
+	output := buf.String()
+	if !strings.Contains(output, expectedFormat) {
+		t.Errorf("Expected output to contain %q, but got %q", expectedFormat, output)
+	}
+}
