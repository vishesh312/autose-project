+from unittest.mock import patch
+from llama_index.core.base.llms.types import ImageBlock
+
+def test_image_block_encoding():
+    image_block = ImageBlock(image=b'raw_image_data', encoding="raw")
+    assert image_block.image is None
+
+    image_block = ImageBlock(image=b'base64_encoded_data', encoding="base64")
+    assert image_block.image == b'YmFzZTY0X2U='
+
+if __name__ == '__main__':
+    test_image_block_encoding()
