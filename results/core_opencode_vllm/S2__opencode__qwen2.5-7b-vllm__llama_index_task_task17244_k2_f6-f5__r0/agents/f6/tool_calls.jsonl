{"name": "write", "kind": "edit", "args": {"content": "from unittest.mock import patch\nfrom llama_index.core.base.llms.types import ImageBlock\n\ndef test_image_block_encoding():\n    image_block = ImageBlock(image=b'raw_image_data', encoding=\"raw\")\n    assert image_block.image == b'raw_image_data'\n\n    image_block = ImageBlock(image=b'base64_encoded_data', encoding=\"base64\")\n    assert image_block.image == b'YmFzZTY0X2U='\n\nif __name__ == '__main__':\n    test_image_block_encoding()", "filePath": "/tmp/parbench-host-pfcre1_0/repo/llama-index-core/llama_index/core/base/llms/test_types.py"}, "ok": true, "ts": null}
