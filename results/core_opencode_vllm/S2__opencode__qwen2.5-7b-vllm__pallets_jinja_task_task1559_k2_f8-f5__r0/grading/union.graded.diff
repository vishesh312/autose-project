+from jinja2.ext import Extension\n\nclass ConditionalI18nExtension(Extension):\n    tags = {"ctrans"}\n\n    def parse(self, parser):\n        condition = parser.parse_expression()\n        variables = parser.parse_variable_declarations()\n        trimmed = parser.stream.current.value == "trimmed"\n        parser.stream.skip()\n        if trimmed:\n            parser.stream.skip()\n        trans_block = self._parse_block(parser)\n        plural_block = None\n        fallback_block = None\n        if parser.stream.current.type == "name" and parser.stream.current.value == "pluralize":\n            parser.stream.next()\n            plural_var = parser.parse_variable_declarations()[0]\n            plural_block = self._parse_block(parser)\n        if parser.stream.current.type != "block_end":\n            parser.fail("expected fallback block", parser.stream.current.lineno)\n        fallback_block = self._parse_block(parser)\n        return self._make_conditional_node(condition, variables, trans_block, plural_block, fallback_block)\n\n    def _parse_block(self, parser):\n        block = []\n        while parser.stream.current.type != "block_end":\n            block.append(parser.parse_statements(["endctrans"], drop_needle=True))\n        return block\n\n    def _trim_whitespace(self, text):\n        return text.strip()\n\n    def _make_conditional_node(self, condition, variables, trans_block, plural_block, fallback_block):\n        if condition:\n            if plural_block:\n                return self.environment.handle_exception(self.environment.call_block(plural_block[0], dict(variables)))\n            return self.environment.handle_exception(self.environment.call_block(trans_block[0], dict(variables)))\n        else:\n            if plural_block:\n                return self.environment.call_block(plural_block[0], dict(variables))\n            return self.environment.call_block(fallback_block[0], dict(variables))
+conditional_i18n = ConditionalI18nExtension
