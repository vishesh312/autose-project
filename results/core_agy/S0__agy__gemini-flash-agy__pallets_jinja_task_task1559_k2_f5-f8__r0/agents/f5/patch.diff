+    def _validate_trans_variables(
+        self,
+        variables: t.Dict[str, nodes.Expr],
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate all variables in a translation block."""
+        reserved_names = {"gettext", "ngettext", "pgettext", "npgettext", "_"}
+
+        for name, expr in variables.items():
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r}: must follow Python identifiers rules.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            if name in reserved_names:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self,
+        name: str,
+        expr: nodes.Expr,
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate an individual expression used in a translation block."""
+        if isinstance(expr, nodes.TemplateData):
+            parser.fail(
+                f"Variable {name!r} contains template data which cannot be used in translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        if isinstance(expr, nodes.Output):
+            parser.fail(
+                f"Variable {name!r} contains output node which cannot be used in translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        if isinstance(expr, (nodes.Const, nodes.Name, nodes.Getattr, nodes.Filter, nodes.Test)):
+            return
+
+        if isinstance(expr, nodes.Call):
+            if isinstance(expr.node, nodes.Name):
+                return
+            parser.fail(
+                f"Variable {name!r} contains complex nested expressions that cannot be used in translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        parser.fail(
+            f"Variable {name!r} contains an invalid expression ({type(expr).__name__}) that cannot be used in translation contexts.",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+
     def _parse_block(
