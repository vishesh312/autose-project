+    def test_trans_variable_validation(self):
+        # Test valid variable expressions
+        tmpl = i18n_env.from_string(
+            "{% trans a='hello', b=42, c=user.name, d=func(), e=val|upper, f=val is defined %}"
+            "{{ a }} {{ b }} {{ c }} {{ d }} {{ e }} {{ f }}"
+            "{% endtrans %}"
+        )
+        assert tmpl is not None
+
+        # Test invalid variable name (Python identifier rule)
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+            mock_parser = type("MockParser", (), {"fail": lambda self, msg, lineno, exc=None: (_ for _ in ()).throw(exc(msg, lineno))})()
+            ext._validate_trans_variables({"123invalid": nodes.Const("val")}, mock_parser, 1)
+        assert "Invalid variable name" in str(exc_info.value)
+        assert "Python identifiers" in str(exc_info.value)
+        assert "123invalid" in str(exc_info.value)
+
+        # Test reserved translation function name conflicts
+        for reserved in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError) as exc_info:
+                i18n_env.from_string(f"{{% trans {reserved}='val' %}}hello{{% endtrans %}}")
+            assert "conflicts with translation function names" in str(exc_info.value)
+            assert reserved in str(exc_info.value)
+
+        # Test template data node rejection
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+            mock_parser = type("MockParser", (), {"fail": lambda self, msg, lineno, exc=None: (_ for _ in ()).throw(exc(msg, lineno))})()
+            ext._validate_trans_variables({"data": nodes.TemplateData("test")}, mock_parser, 1)
+        assert "template data" in str(exc_info.value)
+        assert "translation contexts" in str(exc_info.value)
+
+        # Test output node rejection
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+            mock_parser = type("MockParser", (), {"fail": lambda self, msg, lineno, exc=None: (_ for _ in ()).throw(exc(msg, lineno))})()
+            ext._validate_trans_variables({"out": nodes.Output([nodes.Const("test")])}, mock_parser, 1)
+        assert "translation contexts" in str(exc_info.value)
+
+        # Test complex nested expression in Call rejection
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            i18n_env.from_string("{% trans x=obj.method() %}hello {{ x }}{% endtrans %}")
+        assert "translation contexts" in str(exc_info.value)
+        assert "x" in str(exc_info.value)
+
+        # Test pluralization with validation
+        tmpl_plural = i18n_env.from_string(
+            "{% trans count=1, user='Alice' %}{{ user }} has {{ count }} message"
+            "{% pluralize count %}{{ user }} has {{ count }} messages{% endtrans %}"
+        )
+        assert tmpl_plural is not None
+
