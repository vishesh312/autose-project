diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..c730a38 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,143 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestPathTransform:
+    def test_dict_loader_transform(self):
+        def alias_transform(template):
+            aliases = {"home": "index.html", "contact": "contact-us.html"}
+            return aliases.get(template, template)
+
+        loader = loaders.DictLoader(
+            {"index.html": "Home Page", "contact-us.html": "Contact Us"},
+            path_transform=alias_transform,
+        )
+        env = Environment(loader=loader)
+        assert env.get_template("home").render() == "Home Page"
+        assert env.get_template("contact").render() == "Contact Us"
+
+        # TemplateNotFound should report the original template name
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("missing")
+        assert excinfo.value.name == "missing"
+
+    def test_filesystem_loader_transform(self, tmp_path):
+        tpl = tmp_path / "index.html"
+        tpl.write_text("FS Content")
+
+        def normalize_path(template):
+            return template.lstrip("/").replace("\\", "/")
+
+        loader = loaders.FileSystemLoader(str(tmp_path), path_transform=normalize_path)
+        env = Environment(loader=loader)
+        assert env.get_template("/index.html").render() == "FS Content"
+        assert env.get_template(r"\index.html").render() == "FS Content"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("/missing.html")
+        assert excinfo.value.name == "/missing.html"
+
+    def test_function_loader_transform(self):
+        templates = {"real.html": "Function Content"}
+
+        def load_func(name):
+            if name in templates:
+                return templates[name]
+            return None
+
+        def transform(template):
+            if template.endswith(".tpl"):
+                return template.replace(".tpl", ".html")
+            return template
+
+        loader = loaders.FunctionLoader(load_func, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("real.tpl").render() == "Function Content"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("missing.tpl")
+        assert excinfo.value.name == "missing.tpl"
+
+    def test_package_loader_transform(self):
+        # res package has test.html
+        def transform(template):
+            if template == "alias":
+                return "test.html"
+            return template
+
+        loader = loaders.PackageLoader("res", path_transform=transform)
+        env = Environment(loader=loader)
+        tmpl = env.get_template("alias")
+        assert tmpl.render().strip() == "BAR"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("unknown")
+        assert excinfo.value.name == "unknown"
+
+    def test_prefix_loader_transform(self):
+        app1 = loaders.DictLoader({"index.html": "App1 Index"})
+        # Path transform modifies template before prefix splitting
+        def transform(template):
+            if template.startswith("v2/"):
+                return template[3:]  # strip v2/
+            return template
+
+        loader = loaders.PrefixLoader({"app1": app1}, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("v2/app1/index.html").render() == "App1 Index"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("v2/app1/missing.html")
+        assert excinfo.value.name == "v2/app1/missing.html"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("v2/unknown/index.html")
+        assert excinfo.value.name == "v2/unknown/index.html"
+
+    def test_choice_loader_transform(self):
+        loader1 = loaders.DictLoader({"first.html": "First"})
+        loader2 = loaders.DictLoader({"second.html": "Second"})
+
+        def transform(template):
+            if template == "one":
+                return "first.html"
+            elif template == "two":
+                return "second.html"
+            return template
+
+        loader = loaders.ChoiceLoader([loader1, loader2], path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("one").render() == "First"
+        assert env.get_template("two").render() == "Second"
+
+        with pytest.raises(TemplateNotFound) as excinfo:
+            env.get_template("three")
+        assert excinfo.value.name == "three"
+
+    def test_exception_propagation(self):
+        def bad_transform(template):
+            raise ValueError("custom error")
+
+        loader = loaders.DictLoader({"index.html": "hi"}, path_transform=bad_transform)
+        env = Environment(loader=loader)
+        with pytest.raises(ValueError, match="custom error"):
+            env.get_template("index.html")
+
+    def test_empty_string_handling(self):
+        def transform(template):
+            if template == "":
+                return "default.html"
+            return template
+
+        loader = loaders.DictLoader({"default.html": "Default Content"}, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("").render() == "Default Content"
+
+    def test_null_transform(self):
+        loader = loaders.DictLoader({"index.html": "Content"}, path_transform=None)
+        env = Environment(loader=loader)
+        assert env.get_template("index.html").render() == "Content"
+        with pytest.raises(TemplateNotFound):
+            env.get_template("missing.html")
+
