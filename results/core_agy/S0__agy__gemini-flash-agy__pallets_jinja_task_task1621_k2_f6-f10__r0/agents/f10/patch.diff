diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..d234bbe 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,116 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestPathAliasing:
+    def test_basic_aliasing(self):
+        loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+        loader.add_alias("main.html", "template.html")
+        loader.add_alias("index.html", "template.html")
+
+        env = Environment(loader=loader)
+        assert env.get_template("template.html").render(name="world") == "Hello world!"
+        assert env.get_template("main.html").render(name="world") == "Hello world!"
+        assert env.get_template("index.html").render(name="world") == "Hello world!"
+
+    def test_alias_removal(self):
+        loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+        loader.add_alias("main.html", "template.html")
+        env = Environment(loader=loader)
+        assert env.get_template("main.html").render(name="world") == "Hello world!"
+
+        loader.remove_alias("main.html")
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("main.html")
+        assert exc_info.value.name == "main.html"
+
+    def test_remove_nonexistent_alias(self):
+        loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+        # Calling remove_alias on a nonexistent alias should not raise any error
+        loader.remove_alias("nonexistent.html")
+        loader.add_alias("alias.html", "template.html")
+        loader.remove_alias("other.html")
+
+    def test_alias_error_handling(self):
+        loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+        loader.add_alias("broken.html", "nonexistent.html")
+        env = Environment(loader=loader)
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("broken.html")
+        assert exc_info.value.name == "nonexistent.html"
+
+    def test_alias_overwrite(self):
+        loader = loaders.DictLoader({
+            "first.html": "First: {{ name }}",
+            "second.html": "Second: {{ name }}",
+        })
+        loader.add_alias("alias.html", "first.html")
+        env = Environment(loader=loader)
+        assert env.get_template("alias.html").render(name="world") == "First: world"
+
+        loader.add_alias("alias.html", "second.html")
+        assert env.get_template("alias.html").render(name="world") == "Second: world"
+
+    def test_alias_no_chaining(self):
+        loader = loaders.DictLoader({"actual.html": "Actual content"})
+        loader.add_alias("alias1.html", "actual.html")
+        loader.add_alias("alias2.html", "alias1.html")
+        env = Environment(loader=loader)
+
+        assert env.get_template("alias1.html").render() == "Actual content"
+        # alias2 -> alias1, but aliases should NOT chain recursively
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("alias2.html")
+        assert exc_info.value.name == "alias1.html"
+
+    def test_special_alias_names(self):
+        loader = loaders.DictLoader({"actual.html": "Special name content"})
+        loader.add_alias("", "actual.html")
+        loader.add_alias("with spaces.html", "actual.html")
+        loader.add_alias("special!@#$%^&*()", "actual.html")
+        loader.add_alias("unicode_🔥.html", "actual.html")
+
+        env = Environment(loader=loader)
+        assert env.get_template("").render() == "Special name content"
+        assert env.get_template("with spaces.html").render() == "Special name content"
+        assert env.get_template("special!@#$%^&*()").render() == "Special name content"
+        assert env.get_template("unicode_🔥.html").render() == "Special name content"
+
+    def test_multiple_aliases_to_same_target(self):
+        loader = loaders.DictLoader({"target.html": "Target content"})
+        loader.add_alias("a.html", "target.html")
+        loader.add_alias("b.html", "target.html")
+        loader.add_alias("c.html", "target.html")
+
+        env = Environment(loader=loader)
+        assert env.get_template("a.html").render() == "Target content"
+        assert env.get_template("b.html").render() == "Target content"
+        assert env.get_template("c.html").render() == "Target content"
+
+    def test_loader_subclasses_aliasing(self, filesystem_loader, function_loader, choice_loader, prefix_loader):
+        # FileSystemLoader
+        filesystem_loader.add_alias("alias_test.html", "test.html")
+        env_fs = Environment(loader=filesystem_loader)
+        assert env_fs.get_template("alias_test.html").render().strip() == "BAR"
+        filesystem_loader.remove_alias("alias_test.html")
+
+        # FunctionLoader
+        function_loader.add_alias("alias_fn.html", "justfunction.html")
+        env_fn = Environment(loader=function_loader)
+        assert env_fn.get_template("alias_fn.html").render().strip() == "FOO"
+        function_loader.remove_alias("alias_fn.html")
+
+        # ChoiceLoader
+        choice_loader.add_alias("alias_choice.html", "justdict.html")
+        env_choice = Environment(loader=choice_loader)
+        assert env_choice.get_template("alias_choice.html").render().strip() == "FOO"
+        choice_loader.remove_alias("alias_choice.html")
+
+        # PrefixLoader
+        prefix_loader.add_alias("alias_prefix.html", "b/justdict.html")
+        env_prefix = Environment(loader=prefix_loader)
+        assert env_prefix.get_template("alias_prefix.html").render().strip() == "FOO"
+        prefix_loader.remove_alias("alias_prefix.html")
+
