+func TestMuxDebugLogging(t *testing.T) {
+	var buf bytes.Buffer
+	origOutput := log.Writer()
+	origFlags := log.Flags()
+	defer func() {
+		log.SetOutput(origOutput)
+		log.SetFlags(origFlags)
+	}()
+
+	log.SetOutput(&buf)
+	log.SetFlags(0)
+
+	EnableDebugLogging()
+
+	r := NewRouter()
+	r.Handle("GET /prefix/*", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	r.HandleFunc("POST /items/{id}", func(w http.ResponseWriter, r *http.Request) {})
+	r.Handle("/all-methods", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+
+	output := buf.String()
+	if !strings.Contains(output, "GET") || !strings.Contains(output, "/prefix/*") {
+		t.Errorf("Expected debug log for GET /prefix/*, got:\n%s", output)
+	}
+	if !strings.Contains(output, "POST") || !strings.Contains(output, "/items/{id}") {
+		t.Errorf("Expected debug log for POST /items/{id}, got:\n%s", output)
+	}
+	if !strings.Contains(output, "/all-methods") {
+		t.Errorf("Expected debug log for /all-methods, got:\n%s", output)
 	}
