+class TestI18nValidation:
+    def test_variable_name_validation(self):
+        from jinja2.exceptions import TemplateSyntaxError
+        from jinja2.parser import Parser
+
+        ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+        p = Parser(i18n_env, i18n_env._tokenize("", "test"))
+
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext._validate_trans_variables({"not-an-id": nodes.Const(1)}, p, 1)
+        assert "Invalid variable name" in str(exc_info.value)
+        assert "Python identifiers" in str(exc_info.value)
+
+    def test_reserved_name_conflict(self):
+        from jinja2.exceptions import TemplateSyntaxError
+
+        for reserved in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError) as exc_info:
+                i18n_env.from_string(f"{{% trans {reserved}=1 %}}Hello{{% endtrans %}}")
+            assert "conflicts with translation function names" in str(exc_info.value)
+
+    def test_expression_validation_types(self):
+        from jinja2.exceptions import TemplateSyntaxError
+        from jinja2.parser import Parser
+
+        ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+        p = Parser(i18n_env, i18n_env._tokenize("", "test"))
+
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext._validate_trans_variables({"data": nodes.TemplateData("data")}, p, 1)
+        assert "template data" in str(exc_info.value)
+        assert "translation contexts" in str(exc_info.value)
+
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext._validate_trans_variables({"out": nodes.Output([])}, p, 1)
+        assert "output nodes" in str(exc_info.value)
+        assert "translation contexts" in str(exc_info.value)
+
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            ext._validate_trans_variables({"comp": nodes.Add(nodes.Const(1), nodes.Const(2))}, p, 1)
+        assert "translation contexts" in str(exc_info.value)
+
+    def test_valid_expressions(self):
+        # Const, Name, Call (simple), Getattr, Filter, Test
+        tmpl = i18n_env.from_string(
+            "{% trans a=1, b=user_count, c=user.name, d=user_count|abs %}"
+            "{{ a }} {{ b }} {{ c }} {{ d }}"
+            "{% endtrans %}"
+        )
+        assert tmpl.render(user_count=-5, user={"name": "Alice"}) == "1 -5 Alice 5"
+
