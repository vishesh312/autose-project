+class TestConditionalI18n:
+    def test_conditional_rendering(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.install_null_translations(newstyle=False)
+
+        tmpl = env.from_string(
+            "{% ctrans use_i18n %}Translated content{% fallback %}Fallback content{% endctrans %}"
+        )
+        assert tmpl.render(use_i18n=True) == "Translated content"
+        assert tmpl.render(use_i18n=False) == "Fallback content"
+
+    def test_optional_commas(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.install_null_translations(newstyle=False)
+
+        t1 = env.from_string("{% ctrans use_i18n, count %}{{ count }}{% fallback %}{{ count }}{% endctrans %}")
+        t2 = env.from_string("{% ctrans use_i18n count %}{{ count }}{% fallback %}{{ count }}{% endctrans %}")
+        assert t1.render(use_i18n=True, count=3) == "3"
+        assert t2.render(use_i18n=False, count=3) == "3"
+
+    def test_plural_and_fallback(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.install_null_translations(newstyle=False)
+
+        tmpl = env.from_string(
+            "{% ctrans use_i18n, count %}"
+            "One user"
+            "{% pluralize %}"
+            "{{ count }} users"
+            "{% fallback %}"
+            "Fallback: {{ count }} users"
+            "{% endctrans %}"
+        )
+        assert tmpl.render(use_i18n=True, count=1) == "One user"
+        assert tmpl.render(use_i18n=True, count=2) == "2 users"
+        assert tmpl.render(use_i18n=False, count=2) == "Fallback: 2 users"
+
+    def test_trimmed(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.install_null_translations(newstyle=False)
+
+        tmpl = env.from_string(
+            "{% ctrans use_i18n trimmed %}\n  Hello\n  world\n  "
+            "{% fallback %}\n  Fallback\n  world\n  {% endctrans %}"
+        )
+        assert tmpl.render(use_i18n=True) == "Hello world"
+        assert tmpl.render(use_i18n=False) == "Fallback world"
+
+    def test_trimmed_policy(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.policies["ext.i18n.trimmed"] = True
+        env.install_null_translations(newstyle=False)
+
+        tmpl = env.from_string(
+            "{% ctrans use_i18n %}\n  Hello\n  world\n  "
+            "{% fallback %}\n  Fallback\n  world\n  {% endctrans %}"
+        )
+        assert tmpl.render(use_i18n=True) == "Hello world"
+        assert tmpl.render(use_i18n=False) == "Fallback world"
+
+        tmpl_notrim = env.from_string(
+            "{% ctrans use_i18n notrimmed %}\n  Hello\n  world\n  "
+            "{% fallback %}\n  Fallback\n  world\n  {% endctrans %}"
+        )
+        assert tmpl_notrim.render(use_i18n=False) == "\n  Fallback\n  world\n  "
+
+    def test_newstyle_formatting(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"])
+        env.install_null_translations(newstyle=True)
+
+        tmpl = env.from_string(
+            "{% ctrans use_i18n, count=5 %}Count: {{ count }}{% fallback %}Fallback: {{ count }}{% endctrans %}"
+        )
+        assert tmpl.render(use_i18n=True) == "Count: 5"
+        assert tmpl.render(use_i18n=False) == "Fallback: 5"
+
+    def test_autoescape_handling(self):
+        env = Environment(extensions=["jinja2.ext.i18n", "jinja2.ext.conditional_i18n"], autoescape=True)
+        env.install_null_translations(newstyle=False)
+
+        tmpl = env.from_string(
+            '{% ctrans use_i18n x="<script>" %}<b>trans</b> {{ x }}{% fallback %}<b>fallback</b> {{ x }}{% endctrans %}'
+        )
+        assert tmpl.render(use_i18n=True) == "<b>trans</b> &lt;script&gt;"
+        assert tmpl.render(use_i18n=False) == "<b>fallback</b> &lt;script&gt;"
+
+    def test_missing_fallback_error(self):
+        from jinja2.exceptions import TemplateSyntaxError
+
+        env = Environment(extensions=["jinja2.ext.conditional_i18n"])
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            env.from_string("{% ctrans True %}hello{% endctrans %}")
+        assert "expected 'fallback' block" in str(exc_info.value)
+
+    def test_unclosed_block_error(self):
+        from jinja2.exceptions import TemplateSyntaxError
+
+        env = Environment(extensions=["jinja2.ext.conditional_i18n"])
+        with pytest.raises(TemplateSyntaxError) as exc_info:
+            env.from_string("{% ctrans True %}hello{% fallback %}world")
+        assert "unclosed conditional translation block" in str(exc_info.value)
+
+    def test_duplicate_variable_error(self):
+        from jinja2.exceptions import TemplateAssertionError
+
+        env = Environment(extensions=["jinja2.ext.conditional_i18n"])
+        with pytest.raises(TemplateAssertionError) as exc_info:
+            env.from_string("{% ctrans True x=1, x=2 %}hello{% fallback %}world{% endctrans %}")
+        assert "defined twice" in str(exc_info.value)
