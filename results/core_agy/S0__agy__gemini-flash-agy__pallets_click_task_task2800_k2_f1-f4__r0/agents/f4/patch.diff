diff --git a/tests/test_context.py b/tests/test_context.py
index 5bd618b..a22e45b 100644
--- a/tests/test_context.py
+++ b/tests/test_context.py
@@ -543,3 +543,93 @@ def test_propagate_opt_prefixes():
     ctx = click.Context(click.Command("test2"), parent=parent)
 
     assert ctx._opt_prefixes == {"-", "--", "!"}
+
+
+def test_cleanup_timeout_validation():
+    cli = click.Command("test")
+
+    # None is valid (default)
+    ctx = click.Context(cli, cleanup_timeout=None)
+    assert ctx.cleanup_timeout is None
+
+    # Positive float/int is valid
+    ctx = click.Context(cli, cleanup_timeout=5.0)
+    assert ctx.cleanup_timeout == 5.0
+    ctx = click.Context(cli, cleanup_timeout=2)
+    assert ctx.cleanup_timeout == 2.0
+
+    # Non-positive or invalid values raise ValueError
+    with pytest.raises(ValueError):
+        click.Context(cli, cleanup_timeout=0)
+
+    with pytest.raises(ValueError):
+        click.Context(cli, cleanup_timeout=-1.0)
+
+    with pytest.raises(ValueError):
+        click.Context(cli, cleanup_timeout=True)
+
+    with pytest.raises(ValueError):
+        click.Context(cli, cleanup_timeout="invalid")  # type: ignore
+
+
+def test_cleanup_timeout_inheritance():
+    cli = click.Command("test")
+    sub = click.Command("sub")
+
+    parent = click.Context(cli, cleanup_timeout=3.5)
+    child = click.Context(sub, parent=parent)
+    assert child.cleanup_timeout == 3.5
+
+    # Child can override
+    child_override = click.Context(sub, parent=parent, cleanup_timeout=1.0)
+    assert child_override.cleanup_timeout == 1.0
+
+
+def test_cleanup_timeout_normal_completion():
+    cli = click.Command("test")
+    ctx = click.Context(cli, cleanup_timeout=2.0)
+    called = []
+
+    @ctx.call_on_close
+    def cleanup():
+        called.append(True)
+
+    ctx.close()
+    assert called == [True]
+
+
+def test_cleanup_timeout_hang_termination(caplog):
+    import time
+
+    cli = click.Command("test")
+    ctx = click.Context(cli, cleanup_timeout=0.05)
+    called = []
+
+    @ctx.call_on_close
+    def hanging_cleanup():
+        called.append("started")
+        time.sleep(0.5)
+        called.append("finished")
+
+    with caplog.at_level(logging.WARNING, logger="click"):
+        start = time.perf_counter()
+        ctx.close()
+        duration = time.perf_counter() - start
+
+    assert "started" in called
+    assert "finished" not in called
+    assert duration < 0.4
+    assert any("cleanup timed out" in record.message.lower() for record in caplog.records)
+
+
+def test_cleanup_timeout_exception_propagation():
+    cli = click.Command("test")
+    ctx = click.Context(cli, cleanup_timeout=1.0)
+
+    @ctx.call_on_close
+    def failing_cleanup():
+        raise RuntimeError("cleanup failed")
+
+    with pytest.raises(RuntimeError, match="cleanup failed"):
+        ctx.close()
+
