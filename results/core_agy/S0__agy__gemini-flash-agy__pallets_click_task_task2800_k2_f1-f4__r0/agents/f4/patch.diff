+def test_shell_completion_cleanup_timeout(caplog):
+    import time
+    import logging
+
+    closed = []
+
+    def complete(ctx, param, incomplete):
+        @ctx.call_on_close
+        def hanging_cleanup():
+            closed.append("started")
+            time.sleep(0.5)
+            closed.append("finished")
+
+        return ["opt1", "opt2"]
+
+    cli = Command(
+        "cli",
+        params=[Argument("x", shell_complete=complete)],
+        context_settings={"cleanup_timeout": 0.05},
+    )
+
+    with caplog.at_level(logging.WARNING, logger="click"):
+        start = time.perf_counter()
+        words = _get_words(cli, [], "")
+        duration = time.perf_counter() - start
+
+    assert words == ["opt1", "opt2"]
+    assert "started" in closed
+    assert "finished" not in closed
+    assert duration < 0.4
+    assert any("cleanup timed out" in record.message.lower() for record in caplog.records)
