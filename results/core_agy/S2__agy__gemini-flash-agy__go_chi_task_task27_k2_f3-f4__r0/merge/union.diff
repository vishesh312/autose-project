@@ -107,16 +107,40 @@ func (mx *Mux) Use(middlewares ...func(http.Handler) http.Handler) {
 // Handle adds the route `pattern` that matches any http method to
 // execute the `handler` http.Handler.
 func (mx *Mux) Handle(pattern string, handler http.Handler) {
+	logDebug("Handling pattern: %s", pattern)
+	method, path := mx.parsePattern(pattern)
+	mx.handle(method, path, handler)
+}
+
+// HandleFunc adds the route `pattern` that matches any http method to
+// execute the `handlerFn` http.HandlerFunc.
+func (mx *Mux) HandleFunc(pattern string, handlerFn http.HandlerFunc) {
+	method, path := mx.parsePattern(pattern)
+	mx.handle(method, path, handlerFn)
+}
+
+func (mx *Mux) parsePattern(pattern string) (methodTyp, string) {
 	parts := strings.SplitN(pattern, " ", 2)
 	if len(parts) == 2 {
+		logDebug("Pattern contains HTTP method, parsing...")
 		methodStr := strings.ToUpper(parts[0])
 		path := parts[1]
 
+		logDebug("Method: %s, Path: %s", methodStr, path)
+
 		method, ok := methodMap[methodStr]
 		if !ok {
+			logError("Invalid HTTP method in pattern: %s", methodStr)
 			panic("chi: invalid HTTP method specified in pattern: " + methodStr)
 		}
 
+		// Log the method type for debugging
+		for name, m := range methodMap {
+			if m == method {
+				logDebug("Using method type: %s", name)
+			}
+		}
+
 		mx.handle(method, path, handler)
 		return
 	}
@@ -127,7 +151,21 @@ func (mx *Mux) Handle(pattern string, handler http.Handler) {
 // HandleFunc adds the route `pattern` that matches any http method to
 // execute the `handlerFn` http.HandlerFunc.
 func (mx *Mux) HandleFunc(pattern string, handlerFn http.HandlerFunc) {
+	logDebug("Handling function pattern: %s", pattern)
+	parts := strings.SplitN(pattern, " ", 2)
+	if len(parts) == 2 {
+		logDebug("Function pattern contains HTTP method")
+		methodStr := parts[0]
+		path := parts[1]
+		logDebug("Method: %s, Path: %s", methodStr, path)
+		mx.Handle(pattern, handlerFn)
+		return
+	}
 	mx.handle(mALL, pattern, handlerFn)
+		return method, path
+	}
+
+	return mALL, pattern
 }
 
