+
+        # If string, attempt to parse JSON
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+            except json.JSONDecodeError as e:
+                raise ValueError(f"Unable to parse ToolCalls JSON string: {e}")
+            return cls.validate_input(parsed)
+
+        # If dict
+        if isinstance(data, dict):
+            # Case: already wrapped with 'tool_calls'
+            if "tool_calls" in data:
+                # Assume it's already a list of proper dicts (or ToolCall models)
+                return {"tool_calls": [cls.ToolCall(**tc) if not isinstance(tc, cls.ToolCall) else tc for tc in data["tool_calls"]]}
+            # Single tool call dict
+            if "name" in data and "args" in data:
+                return {"tool_calls": [cls.ToolCall(**data)]}
+            # Unexpected dict format
+            raise ValueError("Invalid dict format for ToolCalls. Expected 'tool_calls' or 'name'/'args' keys.")
+
+        # If list, assume list of tool call dicts
+        if isinstance(data, list):
+            return {"tool_calls": [cls.ToolCall(**item) if not isinstance(item, cls.ToolCall) else item for item in data]}
+
+        # Fallback
+        raise ValueError(f"Unsupported type for ToolCalls input: {type(data)}")
+
