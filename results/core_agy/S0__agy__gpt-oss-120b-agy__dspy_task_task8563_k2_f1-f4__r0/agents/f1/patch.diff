+"""Minimal stub for magicattr library used in DSPy.
+
+Provides a `set` function to set attributes on an object, supporting dotted
+attribute paths (e.g., "foo.bar.baz"). This implementation is sufficient for the
+tests that rely on `magicattr.set` to assign predictor instances within a module.
+"""
+
+from __future__ import annotations
+
+def set(obj: object, name: str, value: object) -> None:
+    """Set a (possibly nested) attribute on ``obj``.
+
+    ``name`` may contain dot separators to indicate nested attributes. The
+    function traverses the attribute chain, creating intermediate objects if they
+    do not exist (by using a simple ``type('Dynamic', (object,), {})`` placeholder).
+    The final attribute is assigned ``value`` via ``setattr``.
+    """
+    parts = name.split('.')
+    target = obj
+    for part in parts[:-1]:
+        # Get existing attribute or create a simple container object
+        if hasattr(target, part):
+            target = getattr(target, part)
+        else:
+            # Create a new empty object to hold nested attributes
+            placeholder = type('Dynamic', (object,), {})()
+            setattr(target, part, placeholder)
+            target = placeholder
+    setattr(target, parts[-1], value)
