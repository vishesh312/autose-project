+class LRUCache(dict):
+    """Simple fallback LRUCache implementation.
+
+    This mimics the interface used in the project: it accepts a ``maxsize``
+    argument and evicts the oldest entry when the size limit is exceeded.
+    """
+    def __init__(self, maxsize=None, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.maxsize = maxsize
+
+    def __setitem__(self, key, value):
+        if self.maxsize is not None and len(self) >= self.maxsize:
+            # Remove oldest item (FIFO) as a simple eviction policy
+            oldest = next(iter(self))
+            del self[oldest]
+        super().__setitem__(key, value)
