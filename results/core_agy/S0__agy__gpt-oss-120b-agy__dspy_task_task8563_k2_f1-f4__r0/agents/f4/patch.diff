+def _canonicalize(value: Any) -> Any:
+    """Recursively sort dict keys, convert tuples to lists, and trim strings.
+    Returns a structure ready for deterministic JSON serialization."""
+    if isinstance(value, dict):
+        # Sort keys
+        return {k: _canonicalize(value[k]) for k in sorted(value)}
+    elif isinstance(value, (list, tuple)):
+        # Convert tuple to list and process elements
+        return [_canonicalize(v) for v in list(value)]
+    elif isinstance(value, str):
+        return value.strip()
+    else:
+        return value
