@@ -0,0 +1,38 @@
+from collections import OrderedDict
+
+class LRUCache(dict):
+    """Simple LRU cache fallback used when the real `cachetools` package is unavailable.
+    It mimics the subset of the interface needed by DSPy tests.
+    """
+    def __init__(self, maxsize=1000, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.maxsize = maxsize
+        self.order = OrderedDict()
+
+    def __setitem__(self, key, value):
+        # Ensure attributes exist for unpickled objects
+        maxsize = getattr(self, "maxsize", 1000)
+        order = getattr(self, "order", OrderedDict())
+        if key in self:
+            order.pop(key, None)
+        elif len(self) >= maxsize:
+            oldest = next(iter(order))
+            order.pop(oldest, None)
+            super().__delitem__(oldest)
+        order[key] = None
+        # Save back possibly missing attributes
+        self.maxsize = maxsize
+        self.order = order
+        super().__setitem__(key, value)
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        # Move to end to mark as recently used
+        order = getattr(self, "order", OrderedDict())
+        order.pop(key, None)
+        order[key] = None
+        self.order = order
+        return value
+
+    def __contains__(self, key):
+        return super().__contains__(key)
