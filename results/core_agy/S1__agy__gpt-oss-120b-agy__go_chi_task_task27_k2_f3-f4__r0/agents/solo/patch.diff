+func TestMuxMethodPatternPrefix(t *testing.T) {
+    r := NewRouter()
+    r.Handle("GET /api/*", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+        w.Write([]byte("prefix hit"))
+    }))
+
+    ts := httptest.NewServer(r)
+    defer ts.Close()
+
+    resp, body := testRequest(t, ts, "GET", "/api/users", nil)
+    if resp.StatusCode != http.StatusOK || body != "prefix hit" {
+        t.Fatalf("expected status %d and body %s, got %d %s", http.StatusOK, "prefix hit", resp.StatusCode, body)
+    }
+
+    resp2, _ := testRequest(t, ts, "GET", "/other", nil)
+    if resp2.StatusCode != http.StatusNotFound {
+        t.Fatalf("expected 404 for non-matching path, got %d", resp2.StatusCode)
+    }
+}
