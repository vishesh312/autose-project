diff --git a/debug_logging.go b/debug_logging.go
new file mode 100644
index 0000000..0e0c38f
--- /dev/null
+++ b/debug_logging.go
@@ -0,0 +1,18 @@
+package chi
+
+import "log"
+
+// debugEnabled indicates whether debug-level logging is active.
+var debugEnabled bool
+
+// EnableDebugLogging turns on debug-level logging; off by default.
+func EnableDebugLogging() {
+    debugEnabled = true
+    log.Printf("chi: debug logging enabled")
+}
+
+func debugLog(format string, args ...interface{}) {
+    if debugEnabled {
+        log.Printf("chi debug: "+format, args...)
+    }
+}
