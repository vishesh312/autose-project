+def test_path_transform():
+    # 1. Template aliasing via transform
+    def alias_transform(template):
+        aliases = {"home": "index.html", "contact": "contact-us.html"}
+        return aliases.get(template, template)
+
+    loader = loaders.DictLoader({"index.html": "HOME", "contact-us.html": "CONTACT"}, path_transform=alias_transform)
+    env = Environment(loader=loader)
+    assert env.get_template("home").render() == "HOME"
+    assert env.get_template("contact").render() == "CONTACT"
+
+    # TemplateNotFound contains original untransformed name
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("missing")
+    assert exc_info.value.name == "missing"
+
+    # 2. Path normalization
+    def normalize_path(template):
+        return template.lstrip("/").replace("\\", "/")
+
+    loader2 = loaders.DictLoader({"sub/test.html": "SUB"}, path_transform=normalize_path)
+    env2 = Environment(loader=loader2)
+    assert env2.get_template(r"/sub\test.html").render() == "SUB"
+
+    # 3. Empty strings handling
+    def default_transform(template):
+        if template == "":
+            return "default.html"
+        return template
+
+    loader3 = loaders.DictLoader({"default.html": "DEFAULT"}, path_transform=default_transform)
+    env3 = Environment(loader=loader3)
+    assert env3.get_template("").render() == "DEFAULT"
+
+    # 4. Exception propagation
+    def broken_transform(template):
+        raise ValueError("transform error")
+
+    loader4 = loaders.DictLoader({"test.html": "OK"}, path_transform=broken_transform)
+    env4 = Environment(loader=loader4)
+    with pytest.raises(ValueError, match="transform error"):
+        env4.get_template("test.html")
+
+    # 5. Across loader types: FileSystemLoader
+    here = Path(__file__).parent.resolve()
+    fs_loader = loaders.FileSystemLoader(
+        here / "res" / "templates",
+        path_transform=lambda p: "test.html" if p == "alias.html" else p,
+    )
+    env_fs = Environment(loader=fs_loader)
+    assert env_fs.get_template("alias.html").render().strip() == "BAR"
+
+    # 6. FunctionLoader
+    fn_loader = loaders.FunctionLoader(
+        {"real.html": "FN"}.get,
+        path_transform=lambda p: "real.html" if p == "virtual.html" else p,
+    )
+    env_fn = Environment(loader=fn_loader)
+    assert env_fn.get_template("virtual.html").render() == "FN"
+
+    # 7. PrefixLoader
+    prefix_loader = loaders.PrefixLoader(
+        {"app": loaders.DictLoader({"index.html": "APP"})},
+        path_transform=lambda p: "app/index.html" if p == "home" else p,
+    )
+    env_prefix = Environment(loader=prefix_loader)
+    assert env_prefix.get_template("home").render() == "APP"
+
+    # 8. ChoiceLoader
+    choice_loader = loaders.ChoiceLoader(
+        [loaders.DictLoader({"real.html": "CHOICE"})],
+        path_transform=lambda p: "real.html" if p == "chosen" else p,
+    )
+    env_choice = Environment(loader=choice_loader)
+    assert env_choice.get_template("chosen").render() == "CHOICE"
+
+
+def test_path_aliasing():
+    loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+    loader.add_alias("main.html", "template.html")
+    loader.add_alias("index.html", "template.html")
+
+    env = Environment(loader=loader)
+    # All three should work identically
+    assert env.get_template("template.html").render(name="World") == "Hello World!"
+    assert env.get_template("main.html").render(name="World") == "Hello World!"
+    assert env.get_template("index.html").render(name="World") == "Hello World!"
+
+    # Alias removal
+    loader.remove_alias("main.html")
+    # Now 'main.html' should raise TemplateNotFound
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("main.html")
+    assert exc_info.value.name == "main.html"
+
+    # Error handling: when an alias points to a nonexistent template,
+    # TemplateNotFound should reference target template name, not alias name
+    loader.add_alias("broken.html", "nonexistent.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("broken.html")
+    assert exc_info.value.name == "nonexistent.html"
+
+    # Aliases should NOT chain (no recursive resolution)
+    loader.add_alias("step1", "template.html")
+    loader.add_alias("step2", "step1")
+    # step2 -> step1, but step1 is not loaded recursively, so it looks for template named "step1"
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("step2")
+    assert exc_info.value.name == "step1"
+
+    # Overwrite alias
+    loader.add_alias("step2", "template.html")
+    assert env.get_template("step2").render(name="World") == "Hello World!"
+
+    # remove_alias is safe to call with nonexistent alias names
+    loader.remove_alias("nonexistent_alias")
+
+    # Works with empty string and special characters
+    loader.add_alias("", "template.html")
+    assert env.get_template("").render(name="World") == "Hello World!"
+    loader.add_alias("@special#key$", "template.html")
+    assert env.get_template("@special#key$").render(name="World") == "Hello World!"
+
