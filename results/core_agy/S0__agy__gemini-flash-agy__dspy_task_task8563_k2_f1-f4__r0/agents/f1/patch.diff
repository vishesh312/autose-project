+            if "tool_calls" not in data and "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+            return data
+        elif isinstance(data, list):
+            if all(isinstance(item, dict) and "name" in item and "args" in item for item in data):
+                return {"tool_calls": data}
+            return data
+
+        return data
