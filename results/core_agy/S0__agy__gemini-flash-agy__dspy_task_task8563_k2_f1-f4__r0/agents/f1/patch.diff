+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            try:
+                parsed = json_repair.loads(data)
+                if parsed == "" and data != "":
+                    parsed = data
+            except Exception:
+                parsed = data
+            data = parsed
+
