+def test_tool_call_fingerprint_and_id():
+    """Test deterministic fingerprinting and id on ToolCall."""
+    tc1 = ToolCalls.ToolCall(name="search", args={"query": "hello", "page": 1})
+    assert len(tc1.fingerprint) == 64
+    assert len(tc1.id) == 8
+    assert tc1.fingerprint.startswith(tc1.id)
+
+    # Identical calls with different arg key orders or whitespace produce same fingerprint
+    tc2 = ToolCalls.ToolCall(name="search", args={"page": 1, "query": "  hello  "})
+    assert tc1.fingerprint == tc2.fingerprint
+    assert tc1.id == tc2.id
+
+    # Tuple vs list
+    tc3 = ToolCalls.ToolCall(name="filter", args={"tags": ("python", "ai")})
+    tc4 = ToolCalls.ToolCall(name="filter", args={"tags": ["  python  ", "ai "]})
+    assert tc3.fingerprint == tc4.fingerprint
+    assert tc3.id == tc4.id
+
+    # Preserves boolean vs int vs string
+    tc_bool = ToolCalls.ToolCall(name="test", args={"val": True})
+    tc_int = ToolCalls.ToolCall(name="test", args={"val": 1})
+    tc_str = ToolCalls.ToolCall(name="test", args={"val": "True"})
+    assert tc_bool.fingerprint != tc_int.fingerprint
+    assert tc_bool.fingerprint != tc_str.fingerprint
+
+    # from_dict_list populates fingerprint and id
+    tcs = ToolCalls.from_dict_list([
+        {"name": "search", "args": {"query": "hello", "page": 1}}
+    ])
+    assert tcs.tool_calls[0].fingerprint == tc1.fingerprint
+    assert tcs.tool_calls[0].id == tc1.id
+
+    # Read-only attributes
+    with pytest.raises(Exception):
+        tc1.fingerprint = "tampered"
+    with pytest.raises(Exception):
+        tc1.id = "tampered"
