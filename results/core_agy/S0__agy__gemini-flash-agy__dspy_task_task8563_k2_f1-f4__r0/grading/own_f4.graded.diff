+def _canonicalize_args(obj: Any) -> Any:
+    """Canonicalize arguments recursively.
+
+    Sorts dict keys, converts tuples to lists, trims leading/trailing whitespace
+    from string values, and preserves numeric and boolean values without type coercion.
+    """
+    if isinstance(obj, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(obj.items(), key=lambda item: str(item[0]))}
+    elif isinstance(obj, (list, tuple)):
+        return [_canonicalize_args(item) for item in obj]
+    elif isinstance(obj, str):
+        return obj.strip()
+    return obj
+
+
+def _compute_tool_call_fingerprint(name: str, args: dict[str, Any]) -> tuple[str, str]:
+    """Compute deterministic SHA-256 fingerprint and 8-character ID for a tool call."""
+    canonical_args = _canonicalize_args(args)
+    payload = {"name": name, "args": canonical_args}
+    serialized = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    fingerprint = hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+    return fingerprint, fingerprint[:8]
+
