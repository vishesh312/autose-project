@@ -247,6 +248,57 @@ class InternationalizationExtension(Extension):
 
     tags = {"trans"}
 
+    # Reserved translation function names that cannot be used as variable names
+    _reserved_names = set(GETTEXT_FUNCTIONS)
+
+    def _validate_trans_expression(self, name: str, expr: nodes.Expr, parser: "Parser", lineno: int) -> None:
+        """Validate a single expression used in a trans block.
+
+        Allowed expression types are literals, variable references, simple
+        function calls, attribute access, filter expressions, and test
+        expressions.  Any other node type results in a template syntax error.
+        """
+        allowed = (
+            nodes.Const,
+            nodes.Name,
+            nodes.Call,
+            nodes.Getattr,
+            nodes.Filter,
+            nodes.Test,
+        )
+        if not isinstance(expr, allowed):
+            parser.fail(
+                f"Invalid expression for variable '{name}': {type(expr).__name__} is not allowed in translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+    def _validate_trans_variables(self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int) -> None:
+        """Validate variable names and expressions for translation blocks.
+
+        - Variable names must be valid Python identifiers and not reserved
+          translation function names.
+        - Each expression is validated for allowed node types.
+        """
+        for name, expr in variables.items():
+            # Identifier validation
+            if not name.isidentifier() or keyword.iskeyword(name):
+                parser.fail(
+                    f"Invalid variable name '{name}': must be a valid Python identifier.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Reserved name conflict
+            if name in self._reserved_names:
+                parser.fail(
+                    f"Variable name '{name}' conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Expression validation
+            self._validate_trans_expression(name, expr, parser, lineno)
+
