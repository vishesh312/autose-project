+    def test_trans_variable_validation(self):
+        from jinja2.exceptions import TemplateSyntaxError
+
+        # Invalid Python identifier (e.g., keyword)
+        with pytest.raises(TemplateSyntaxError, match="Invalid variable name.*Python identifiers"):
+            i18n_env.from_string("{% trans class=42 %}{{ class }}{% endtrans %}")
+
+        # Reserved translation function names
+        for reserved in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+                i18n_env.from_string(f"{{% trans {reserved}=42 %}}{{{{ {reserved} }}}}{{% endtrans %}}")
+            with pytest.raises(TemplateSyntaxError, match="conflicts with translation function names"):
+                i18n_env.from_string(f"{{% trans %}}{{{{ {reserved} }}}}{{% endtrans %}}")
+
+        # Complex / disallowed expression types
+        with pytest.raises(TemplateSyntaxError, match="template data.*translation contexts"):
+            i18n_env.from_string("{% trans x=[1, 2] %}{{ x }}{% endtrans %}")
+
+        # Allowed expressions
+        tmpl = i18n_env.from_string("{% trans a=1, b='str', c=foo.bar, d=func(42), e=x|upper, f=y is defined %}{{ a }} {{ b }} {{ c }} {{ d }} {{ e }} {{ f }}{% endtrans %}")
+        assert tmpl is not None
+
+    def test_conditional_i18n(self):
+        from jinja2.ext import ConditionalI18nExtension, conditional_i18n
+        from jinja2.exceptions import TemplateSyntaxError, TemplateAssertionError
+        import gettext
+
+        class MockTranslations(gettext.NullTranslations):
+            def gettext(self, message):
+                if message == "Hello %(name)s":
+                    return "Hola %(name)s"
+                return message
+
+            def ngettext(self, singular, plural, n):
+                if n == 1:
+                    return f"{n} manzana"
+                return f"{n} manzanas"
+
+        env = Environment(extensions=[ConditionalI18nExtension, "jinja2.ext.i18n"])
+        env.install_gettext_translations(MockTranslations())
+
+        # Basic rendering with comma and without comma
+        t1 = env.from_string("{% ctrans use_i18n, name %}Hello {{ name }}{% fallback %}Hi {{ name }}{% endctrans %}")
+        assert t1.render(use_i18n=True, name="World") == "Hola World"
+        assert t1.render(use_i18n=False, name="World") == "Hi World"
+
+        t2 = env.from_string("{% ctrans use_i18n name %}Hello {{ name }}{% fallback %}Hi {{ name }}{% endctrans %}")
+        assert t2.render(use_i18n=True, name="World") == "Hola World"
+        assert t2.render(use_i18n=False, name="World") == "Hi World"
+
+        # Pluralize support
+        t3 = env.from_string(
+            "{% ctrans cond, count %}{{ count }} apple{% pluralize count %}{{ count }} apples{% fallback %}{{ count }} item(s){% endctrans %}"
+        )
+        assert t3.render(cond=True, count=1) == "1 manzana"
+        assert t3.render(cond=True, count=2) == "2 manzanas"
+        assert t3.render(cond=False, count=2) == "2 item(s)"
+
+        # Trimming behavior
+        t4 = env.from_string(
+            "{% ctrans cond, trimmed %}\n  Hello\n{% fallback %}\n  Hi\n{% endctrans %}"
+        )
+        assert t4.render(cond=True) == "Hello"
+        assert t4.render(cond=False) == "Hi"
+
+        # Module-level alias check
+        assert conditional_i18n is ConditionalI18nExtension
+
+        # Error cases
+        with pytest.raises(TemplateSyntaxError, match="expected 'fallback' block"):
+            env.from_string("{% ctrans cond %}Hello{% endctrans %}")
+
+        with pytest.raises(TemplateSyntaxError, match="unclosed conditional translation block"):
+            env.from_string("{% ctrans cond %}Hello{% fallback %}Hi")
+
+        with pytest.raises(TemplateAssertionError, match="defined twice"):
+            env.from_string("{% ctrans cond, x, x %}Hello{% fallback %}Hi{% endctrans %}")
+
