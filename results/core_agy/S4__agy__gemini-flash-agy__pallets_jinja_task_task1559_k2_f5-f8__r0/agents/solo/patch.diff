+    def _validate_trans_variables(
+        self,
+        variables: t.Dict[str, nodes.Expr],
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate variables used in translation blocks."""
+        import keyword
+
+        reserved_names = {"gettext", "ngettext", "pgettext", "npgettext", "_"}
+        for name, expr in variables.items():
+            if not name.isidentifier() or keyword.iskeyword(name):
+                parser.fail(
+                    f"Invalid variable name {name!r}. Variable names in translation blocks must be valid Python identifiers.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            if name in reserved_names:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self,
+        name: str,
+        expr: nodes.Expr,
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate individual translation variable expression."""
+        if isinstance(expr, (nodes.TemplateData, nodes.Output)):
+            parser.fail(
+                f"Variable {name!r} uses invalid template data or output node incompatible with translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        if isinstance(expr, (nodes.Const, nodes.Name)):
+            return
+        if isinstance(expr, nodes.Call):
+            if not isinstance(expr.node, nodes.Name):
+                parser.fail(
+                    f"Variable {name!r} uses a complex call incompatible with translation contexts; only simple function calls are allowed.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            return
+        if isinstance(expr, nodes.Getattr):
+            return
+        if isinstance(expr, (nodes.Filter, nodes.Test)):
+            return
+        parser.fail(
+            f"Variable {name!r} has expression of type {type(expr).__name__} which cannot be used as template data in translation contexts.",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+
+
+class ConditionalI18nExtension(Extension):
+    """Adds a `ctrans` tag to Jinja that conditionally renders translations."""
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+
+        # Parse condition
+        condition = parser.parse_expression()
+
+        # Parse optional comma
+        parser.stream.skip_if("comma")
+
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+
+        while parser.stream.current.type != "block_end":
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                parser.stream.skip_if("comma")
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+            parser.stream.skip_if("comma")
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        have_plural = False
+        fallback = None
+        referenced: t.Set[str] = set()
+
+        singular_names, singular = self._parse_block(parser, "singular")
+        if singular_names:
+            referenced.update(singular_names)
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+                num_called_num = singular_names[0] == "num"
+
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, "pluralize")
+            referenced.update(plural_names)
+
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail(
+                "expected 'fallback' block in conditional translation block",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, "fallback")
+        next(parser.stream)  # consume endctrans
+        referenced.update(fallback_names)
+
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+            if fallback:
+                fallback = self._trim_whitespace(fallback)
+
+        if_node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback,
+            variables,
+            plural_expr,
+            bool(referenced),
+            num_called_num and have_plural,
+        )
+        if_node.set_lineno(lineno)
+        if plural_expr_assignment is not None:
+            return [plural_expr_assignment, if_node]
+        return if_node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", current_section: str
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next ctrans section tag."""
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    if current_section == "fallback":
+                        break
+                    parser.fail(
+                        "expected 'fallback' block before endctrans",
+                        exc=TemplateSyntaxError,
+                    )
+                elif parser.stream.current.test("name:pluralize"):
+                    if current_section == "singular":
+                        break
+                    parser.fail(
+                        "a conditional translatable section can have only one pluralize section"
+                    )
+                elif parser.stream.current.test("name:fallback"):
+                    if current_section in ("singular", "pluralize"):
+                        break
+                    parser.fail(
+                        "a conditional translatable section can have only one fallback section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail(
+                    "unclosed conditional translation block",
+                    exc=TemplateSyntaxError,
+                )
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+        num_called_num: bool,
+    ) -> nodes.If:
+        """Create an If node for conditional translation rendering."""
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+
+        trans_singular = singular
+        trans_plural = plural
+        fb_singular = fallback
+
+        if not vars_referenced and not newstyle:
+            trans_singular = trans_singular.replace("%%", "%")
+            if trans_plural:
+                trans_plural = trans_plural.replace("%%", "%")
+            fb_singular = fb_singular.replace("%%", "%")
+
+        # Translation branch
+        trans_node: nodes.Expr
+        if plural_expr is None:
+            gettext_node = nodes.Name("gettext", "load")
+            trans_node = nodes.Call(
+                gettext_node, [nodes.Const(trans_singular)], [], None, None
+            )
+        else:
+            ngettext_node = nodes.Name("ngettext", "load")
+            trans_node = nodes.Call(
+                ngettext_node,
+                [nodes.Const(trans_singular), nodes.Const(trans_plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        if newstyle:
+            for key, value in variables.items():
+                if num_called_num and key == "num":
+                    continue
+                trans_node.kwargs.append(nodes.Keyword(key, value))
+        else:
+            trans_node = nodes.MarkSafeIfAutoescape(trans_node)
+            if variables:
+                trans_node = nodes.Mod(
+                    trans_node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+
+        # Fallback branch
+        fb_node: nodes.Expr
+        if variables:
+            fb_node = nodes.Mod(
+                nodes.MarkSafeIfAutoescape(nodes.Const(fb_singular)),
+                nodes.Dict(
+                    [
+                        nodes.Pair(nodes.Const(key), value)
+                        for key, value in variables.items()
+                    ]
+                ),
+            )
+        else:
+            fb_node = nodes.MarkSafeIfAutoescape(nodes.Const(fb_singular))
+
+        return nodes.If(
+            condition,
+            [nodes.Output([trans_node])],
+            [],
+            [nodes.Output([fb_node])],
+        )
+
 
