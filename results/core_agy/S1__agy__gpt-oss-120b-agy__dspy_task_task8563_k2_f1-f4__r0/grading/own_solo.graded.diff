 class ToolCalls(Type):
+    """ToolCalls type representing a collection of tool calls.
+
+    The class now includes a ``validate_input`` method that normalizes various
+    possible LM output formats into a canonical Python structure.
+    """
+
+    class ToolCall(BaseModel):
+        """Represents a single tool call.
+
+        A deterministic ``fingerprint`` is computed from the tool ``name`` and
+        a canonical representation of ``args``. The first eight characters of the
+        SHA‑256 hash are exposed as ``id`` for convenient logging.
+        """
+
+        name: str
+        args: dict[str, Any]
+        # The fingerprint and short id are computed at construction time and are
+        # read‑only attributes.
+        fingerprint: str = ""
+        id: str = ""
+
+        def __init__(self, **data: Any):  # type: ignore[override]
+            super().__init__(**data)
+            # Compute a deterministic fingerprint based on name and canonical args.
+            fp = _compute_fingerprint(self.name, self.args)
+            object.__setattr__(self, "fingerprint", fp)
+            object.__setattr__(self, "id", fp[:8])
+
+    tool_calls: list[ToolCall]
+
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize various LM output formats for ``ToolCalls``.
+
+        Supported input variations:
+        1. ``{"tool_calls": [{"name": ..., "args": {...}}, ...]}``
+        2. A single object ``{"name": ..., "args": {...}}``
+        3. A bare list ``[{"name": ..., "args": {...}}, ...]``
+        4. JSON strings representing any of the above structures.
+        Non‑JSON strings are returned unchanged.
+        """
+        # If already a dict with the canonical key, return as‑is.
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+            # Unexpected dict – return unchanged.
+            return data
+        # A list of call dicts.
+        if isinstance(data, list):
+            return {"tool_calls": data}
+        # If a string, attempt to parse JSON.
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+            except Exception:
+                return data
+            # Re‑apply normalization to the parsed value.
+            return cls.validate_input(parsed)
+        # Fallback – return the original value.
+        return data
+
+    @classmethod
+    def from_dict_list(cls, tool_calls_dicts: list[dict[str, Any]]) -> "ToolCalls":
+        """Convert a list of dictionaries to a ToolCalls instance.
+
+        Each dictionary should contain ``name`` and ``args`` keys. The method now
+        ensures that each ``ToolCall`` has a deterministic fingerprint.
+        """
+        tool_calls = [cls.ToolCall(**item) for item in tool_calls_dicts]
+        return cls(tool_calls=tool_calls)
+
+    @classmethod
+    def description(cls) -> str:
+        return (
+            "Tool calls information, including the name of the tools and the arguments to be passed to it. "
+            "Arguments must be provided in JSON format."
+        )
+
+    def format(self) -> list[dict[str, Any]]:
+        # The tool_call field is compatible with OpenAI's tool calls schema.
+        return [
+            {
+                "type": "tool_calls",
+                "tool_calls": [
+                    {
+                        "type": "function",
+                        "function": {
+                            "name": tool_call.name,
+                            "arguments": tool_call.args,
+                        },
+                    }
+                    for tool_call in self.tool_calls
+                ],
+            }
+        ]
+
