+def canonicalize_args(args: Any) -> Any:
+    """Canonicalize arguments for stable fingerprinting.
+
+    - Sort keys in dicts recursively.
+    - Convert tuples to lists for consistency.
+    - Strip leading/trailing whitespace from string values.
+    - Leave numeric, boolean, and other types unchanged.
+    """
+    if isinstance(args, dict):
+        return {k: canonicalize_args(v) for k, v in sorted(args.items())}
+    elif isinstance(args, (list, tuple)):
+        return [canonicalize_args(item) for item in args]
+    elif isinstance(args, str):
+        return args.strip()
+    return args
+
+
+def compute_tool_call_fingerprint(name: str, args: dict[str, Any]) -> tuple[str, str]:
+    canonical_args = canonicalize_args(args)
+    payload = {"name": name, "args": canonical_args}
+    serialized = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    fp = hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+    return fp, fp[:8]
+
