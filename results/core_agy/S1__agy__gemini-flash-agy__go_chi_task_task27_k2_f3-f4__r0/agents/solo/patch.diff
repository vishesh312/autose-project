+func TestEnableDebugLogging(t *testing.T) {
+	var buf bytes.Buffer
+	origOutput := log.Writer()
+	origFlags := log.Flags()
+	defer func() {
+		log.SetOutput(origOutput)
+		log.SetFlags(origFlags)
+	}()
+
+	log.SetOutput(&buf)
+	log.SetFlags(0)
+
+	EnableDebugLogging()
+
+	r := NewRouter()
+	r.Handle("GET /test/handle/*", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("ok"))
+	}))
+	r.HandleFunc("POST /test/handlefunc/*", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("ok"))
+	})
+	r.HandleFunc("/test/all", func(w http.ResponseWriter, r *http.Request) {
+		w.Write([]byte("ok"))
+	})
+
+	output := buf.String()
+	if !strings.Contains(output, "GET") || !strings.Contains(output, "/test/handle/*") {
+		t.Errorf("expected debug log to contain GET and /test/handle/*, got: %s", output)
+	}
+	if !strings.Contains(output, "POST") || !strings.Contains(output, "/test/handlefunc/*") {
+		t.Errorf("expected debug log to contain POST and /test/handlefunc/*, got: %s", output)
+	}
+	if !strings.Contains(output, "/test/all") {
+		t.Errorf("expected debug log to contain /test/all, got: %s", output)
+	}
+}
