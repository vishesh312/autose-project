diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..e555c83 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,125 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+class TestPathTransform:
+    def test_dict_loader_transform(self):
+        def alias_transform(template):
+            aliases = {"home": "index.html", "contact": "contact-us.html"}
+            return aliases.get(template, template)
+
+        loader = loaders.DictLoader(
+            {"index.html": "HOME", "contact-us.html": "CONTACT"},
+            path_transform=alias_transform,
+        )
+        env = Environment(loader=loader)
+        assert env.get_template("home").render() == "HOME"
+        assert env.get_template("contact").render() == "CONTACT"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("about")
+        assert exc_info.value.name == "about"
+
+    def test_filesystem_loader_transform(self, filesystem_loader):
+        def normalize_transform(template):
+            return template.lstrip("/").replace("\\", "/")
+
+        loader = loaders.FileSystemLoader(
+            filesystem_loader.searchpath, path_transform=normalize_transform
+        )
+        env = Environment(loader=loader)
+        tmpl = env.get_template("/test.html")
+        assert tmpl.render().strip() == "BAR"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("/missing.html")
+        assert exc_info.value.name == "/missing.html"
+
+    def test_package_loader_transform(self):
+        def transform(template):
+            if template == "main":
+                return "test.html"
+            return template
+
+        loader = loaders.PackageLoader("res", path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("main").render().strip() == "BAR"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("nonexistent")
+        assert exc_info.value.name == "nonexistent"
+
+    def test_function_loader_transform(self):
+        def load_func(name):
+            if name == "real_template.html":
+                return "CONTENT"
+            return None
+
+        def transform(name):
+            if name == "alias":
+                return "real_template.html"
+            return name
+
+        loader = loaders.FunctionLoader(load_func, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("alias").render() == "CONTENT"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("other")
+        assert exc_info.value.name == "other"
+
+    def test_prefix_loader_transform(self):
+        sub_loader = loaders.DictLoader({"sub.html": "SUB CONTENT"})
+        # Path transform modifies template before prefix splitting
+        def transform(name):
+            if name == "short":
+                return "prefix/sub.html"
+            return name
+
+        loader = loaders.PrefixLoader({"prefix": sub_loader}, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("short").render() == "SUB CONTENT"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("nonexistent")
+        assert exc_info.value.name == "nonexistent"
+
+    def test_choice_loader_transform(self):
+        loader1 = loaders.DictLoader({"one.html": "ONE"})
+        loader2 = loaders.DictLoader({"two.html": "TWO"})
+
+        def transform(name):
+            if name == "first":
+                return "one.html"
+            if name == "second":
+                return "two.html"
+            return name
+
+        loader = loaders.ChoiceLoader([loader1, loader2], path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("first").render() == "ONE"
+        assert env.get_template("second").render() == "TWO"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("third")
+        assert exc_info.value.name == "third"
+
+    def test_transform_empty_string(self):
+        def transform(template):
+            if template == "":
+                return "default.html"
+            return template
+
+        loader = loaders.DictLoader({"default.html": "DEFAULT"}, path_transform=transform)
+        env = Environment(loader=loader)
+        assert env.get_template("").render() == "DEFAULT"
+
+    def test_transform_exception_propagation(self):
+        def buggy_transform(template):
+            raise ValueError("custom transform error")
+
+        loader = loaders.DictLoader({"index.html": "HOME"}, path_transform=buggy_transform)
+        env = Environment(loader=loader)
+        with pytest.raises(ValueError, match="custom transform error"):
+            env.get_template("index.html")
+
+    def test_none_transform(self):
+        loader = loaders.DictLoader({"index.html": "HOME"}, path_transform=None)
+        env = Environment(loader=loader)
+        assert env.get_template("index.html").render() == "HOME"
+
