diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..40ec39f 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -401,3 +401,97 @@ def test_pep_451_import_hook():
         assert "test.html" in package_loader.list_templates()
     finally:
         sys.meta_path[:] = before
+
+
+def test_template_path_aliasing(dict_loader, filesystem_loader, package_loader, choice_loader, function_loader, prefix_loader):
+    from jinja2 import DictLoader
+
+    loader = DictLoader({"template.html": "Hello {{ name }}!"})
+    loader.add_alias("main.html", "template.html")
+    loader.add_alias("index.html", "template.html")
+
+    env = Environment(loader=loader)
+    assert env.get_template("template.html").render(name="World") == "Hello World!"
+    assert env.get_template("main.html").render(name="World") == "Hello World!"
+    assert env.get_template("index.html").render(name="World") == "Hello World!"
+
+    # Alias removal
+    loader.remove_alias("main.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("main.html")
+    assert exc_info.value.name == "main.html"
+
+    # Nonexistent target error references target name
+    loader.add_alias("broken.html", "nonexistent.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("broken.html")
+    assert exc_info.value.name == "nonexistent.html"
+
+    # Overwrite alias
+    loader.add_alias("index.html", "broken.html")  # No chaining!
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("index.html")
+    assert exc_info.value.name == "broken.html"
+
+    # No chaining test: alias1 -> alias2 -> target
+    # Looking up alias1 should resolve to alias2, NOT recursively to target
+    loader.add_alias("alias1.html", "alias2.html")
+    loader.add_alias("alias2.html", "template.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        env.get_template("alias1.html")
+    assert exc_info.value.name == "alias2.html"
+
+    # remove_alias safe with nonexistent alias
+    loader.remove_alias("does_not_exist.html")
+
+    # Special characters and empty strings
+    loader.add_alias("", "template.html")
+    assert env.get_template("").render(name="World") == "Hello World!"
+    loader.add_alias("!@#$%^&*()_+ space / \\", "template.html")
+    assert env.get_template("!@#$%^&*()_+ space / \\").render(name="World") == "Hello World!"
+
+    # Test with FileSystemLoader
+    filesystem_loader.add_alias("alias_test.html", "test.html")
+    fs_env = Environment(loader=filesystem_loader)
+    assert fs_env.get_template("alias_test.html").render().strip() == "BAR"
+    filesystem_loader.add_alias("fs_broken.html", "missing.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        fs_env.get_template("fs_broken.html")
+    assert exc_info.value.name == "missing.html"
+
+    # Test with PackageLoader
+    package_loader.add_alias("pkg_alias.html", "test.html")
+    pkg_env = Environment(loader=package_loader)
+    assert pkg_env.get_template("pkg_alias.html").render().strip() == "BAR"
+    package_loader.add_alias("pkg_broken.html", "missing.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        pkg_env.get_template("pkg_broken.html")
+    assert exc_info.value.name == "missing.html"
+
+    # Test with FunctionLoader
+    function_loader.add_alias("func_alias.html", "justfunction.html")
+    func_env = Environment(loader=function_loader)
+    assert func_env.get_template("func_alias.html").render().strip() == "FOO"
+    function_loader.add_alias("func_broken.html", "missing.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        func_env.get_template("func_broken.html")
+    assert exc_info.value.name == "missing.html"
+
+    # Test with ChoiceLoader
+    choice_loader.add_alias("choice_alias.html", "justdict.html")
+    choice_env = Environment(loader=choice_loader)
+    assert choice_env.get_template("choice_alias.html").render().strip() == "FOO"
+    choice_loader.add_alias("choice_broken.html", "missing.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        choice_env.get_template("choice_broken.html")
+    assert exc_info.value.name == "missing.html"
+
+    # Test with PrefixLoader
+    prefix_loader.add_alias("prefix_alias.html", "a/test.html")
+    prefix_env = Environment(loader=prefix_loader)
+    assert prefix_env.get_template("prefix_alias.html").render().strip() == "BAR"
+    prefix_loader.add_alias("prefix_broken.html", "a/missing.html")
+    with pytest.raises(TemplateNotFound) as exc_info:
+        prefix_env.get_template("prefix_broken.html")
+    assert exc_info.value.name == "a/missing.html"
+
