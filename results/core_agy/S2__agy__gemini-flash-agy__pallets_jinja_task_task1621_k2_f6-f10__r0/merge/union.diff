+def _invalidate_template_cache(alias: str) -> None:
+    """Invalidate cached templates for alias in any active Environments."""
+    import gc
+    for obj in gc.get_objects():
+        # Check for Environment instances without importing dynamically
+        if type(obj).__name__ == "Environment" and getattr(obj, "cache", None) is not None:
+            for k in list(obj.cache.keys()):
+                if isinstance(k, tuple) and len(k) == 2:
+                    tmpl_name = k[1]
+                    if tmpl_name == alias or (isinstance(tmpl_name, str) and tmpl_name.endswith("/" + alias)):
+                        try:
+                            del obj.cache[k]
+                        except KeyError:
+                            pass
+
