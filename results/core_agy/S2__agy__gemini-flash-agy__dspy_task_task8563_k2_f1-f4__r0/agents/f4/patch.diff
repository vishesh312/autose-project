+def test_tool_call_fingerprint():
+    """Test deterministic fingerprinting for ToolCall."""
+    # Key order and string trimming should produce identical fingerprints
+    call1 = ToolCalls.ToolCall(name="search", args={"query": "hello", "limit": 10})
+    call2 = ToolCalls.ToolCall(name="search", args={"limit": 10, "query": "  hello  "})
+
+    assert call1.fingerprint == call2.fingerprint
+    assert call1.id == call2.id
+    assert len(call1.fingerprint) == 64
+    assert len(call1.id) == 8
+    assert call1.id == call1.fingerprint[:8]
+
+    # Tuple to list conversion
+    call_tuple = ToolCalls.ToolCall(name="filter", args={"tags": ("a", "b")})
+    call_list = ToolCalls.ToolCall(name="filter", args={"tags": ["a", "b"]})
+    assert call_tuple.fingerprint == call_list.fingerprint
+
+    # Preserves boolean and numeric types (no string coercion)
+    call_bool = ToolCalls.ToolCall(name="check", args={"flag": True, "count": 1})
+    call_str = ToolCalls.ToolCall(name="check", args={"flag": "True", "count": "1"})
+    assert call_bool.fingerprint != call_str.fingerprint
+
+    # Tool name differences produce different fingerprints
+    call_other_name = ToolCalls.ToolCall(name="lookup", args={"query": "hello", "limit": 10})
+    assert call1.fingerprint != call_other_name.fingerprint
+
+    # ToolCall from from_dict_list
+    calls = ToolCalls.from_dict_list([{"name": "search", "args": {"query": "hello", "limit": 10}}])
+    assert calls.tool_calls[0].fingerprint == call1.fingerprint
+    assert calls.tool_calls[0].id == call1.id
+
+    # Nested structures
+    call_nested1 = ToolCalls.ToolCall(
+        name="nested",
+        args={"outer": {"b": 2, "a": " test "}, "items": [{"k": "v"}, (1, 2)]},
+    )
+    call_nested2 = ToolCalls.ToolCall(
+        name="nested",
+        args={"items": [{"k": "v"}, [1, 2]], "outer": {"a": "test", "b": 2}},
+    )
+    assert call_nested1.fingerprint == call_nested2.fingerprint
+
+    # Read-only attributes
+    with pytest.raises(Exception):
+        call1.fingerprint = "new_fingerprint"
+
+    with pytest.raises(Exception):
+        call1.id = "new_id"
