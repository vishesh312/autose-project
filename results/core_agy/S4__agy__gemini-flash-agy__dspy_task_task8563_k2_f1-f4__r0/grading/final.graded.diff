+def _canonicalize_tool_args(val: Any) -> Any:
+    """Canonicalize args recursively for deterministic fingerprinting."""
+    if isinstance(val, dict):
+        return {k: _canonicalize_tool_args(v) for k, v in sorted(val.items())}
+    elif isinstance(val, (list, tuple)):
+        return [_canonicalize_tool_args(item) for item in val]
+    elif isinstance(val, str):
+        return val.strip()
+    return val
+
+
+def _compute_tool_call_fingerprint(name: str, args: dict[str, Any]) -> tuple[str, str]:
+    """Compute sha256 fingerprint and 8-char id for a tool call."""
+    canonical_args = _canonicalize_tool_args(args)
+    data = {"name": name, "args": canonical_args}
+    serialized = json.dumps(data, sort_keys=True, separators=(",", ":"))
+    fp = hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+    return fp, fp[:8]
+
