+def test_tool_calls_fingerprint():
+    # Test fingerprint and id generation
+    call1 = ToolCalls.ToolCall(name="foo", args={"b": " world ", "a": 1})
+    call2 = ToolCalls.ToolCall(name="foo", args={"a": 1, "b": "world"})
+    call3 = ToolCalls.ToolCall(name="foo", args={"a": 1, "b": "other"})
+    call4 = ToolCalls.ToolCall(name="bar", args={"a": 1, "b": "world"})
+
+    assert len(call1.fingerprint) == 64
+    assert len(call1.id) == 8
+    assert call1.fingerprint.startswith(call1.id)
+
+    # Identical canonical args produces same fingerprint and id
+    assert call1.fingerprint == call2.fingerprint
+    assert call1.id == call2.id
+    # Call with identical args dict
+    call2_exact = ToolCalls.ToolCall(name="foo", args={"b": " world ", "a": 1})
+    assert call1 == call2_exact
+
+    # Different args or names produce different fingerprints
+    assert call1.fingerprint != call3.fingerprint
+    assert call1.fingerprint != call4.fingerprint
+
+    # Test tuple conversion to list
+    call_tuple = ToolCalls.ToolCall(name="baz", args={"items": (1, 2, " test ")})
+    call_list = ToolCalls.ToolCall(name="baz", args={"items": [1, 2, "test"]})
+    assert call_tuple.fingerprint == call_list.fingerprint
+
+    # Preserves boolean and numeric types
+    call_bool_num = ToolCalls.ToolCall(name="test", args={"flag": True, "count": 1, "ratio": 1.5})
+    assert call_bool_num.fingerprint == ToolCalls.ToolCall(name="test", args={"count": 1, "flag": True, "ratio": 1.5}).fingerprint
+
+    # Read-only attributes
+    with pytest.raises(AttributeError):
+        call1.fingerprint = "new_fingerprint"
+
+    with pytest.raises(AttributeError):
+        call1.id = "new_id"
+
+    # from_dict_list includes fingerprints
+    tc = ToolCalls.from_dict_list([{"name": "foo", "args": {"a": 1}}])
+    assert len(tc.tool_calls[0].fingerprint) == 64
+    assert len(tc.tool_calls[0].id) == 8
+
