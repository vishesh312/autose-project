+def test_tool_calls_validate_input():
+    # 1. Single object without outer tool_calls key
+    single_dict = {"name": "search", "args": {"query": "dspy"}}
+    res1 = ToolCalls.validate_input(single_dict)
+    assert res1 == {"tool_calls": [single_dict]}
+
+    # Pydantic parsing with single object
+    tc1 = ToolCalls.model_validate(single_dict)
+    assert len(tc1.tool_calls) == 1
+    assert tc1.tool_calls[0].name == "search"
+
+    # 2. Bare list of tool call objects
+    list_dicts = [
+        {"name": "search", "args": {"query": "dspy"}},
+        {"name": "lookup", "args": {"key": "value"}},
+    ]
+    res2 = ToolCalls.validate_input(list_dicts)
+    assert res2 == {"tool_calls": list_dicts}
+
+    tc2 = ToolCalls.model_validate(list_dicts)
+    assert len(tc2.tool_calls) == 2
+    assert tc2.tool_calls[1].name == "lookup"
+
+    # 3. Canonical format with tool_calls key
+    canonical_dict = {"tool_calls": list_dicts}
+    res3 = ToolCalls.validate_input(canonical_dict)
+    assert res3 == canonical_dict
+
+    tc3 = ToolCalls.model_validate(canonical_dict)
+    assert len(tc3.tool_calls) == 2
+
+    # 4. JSON strings
+    json_str_single = '{"name": "search", "args": {"query": "dspy"}}'
+    assert ToolCalls.validate_input(json_str_single) == {"tool_calls": [single_dict]}
+
+    json_str_list = '[{"name": "search", "args": {"query": "dspy"}}]'
+    assert ToolCalls.validate_input(json_str_list) == {"tool_calls": [{"name": "search", "args": {"query": "dspy"}}]}
+
+    json_str_canonical = '{"tool_calls": [{"name": "search", "args": {"query": "dspy"}}]}'
+    assert ToolCalls.validate_input(json_str_canonical) == {"tool_calls": [{"name": "search", "args": {"query": "dspy"}}]}
+
+    # 5. Non-JSON string unchanged
+    non_json = "not a json string"
+    assert ToolCalls.validate_input(non_json) == "not a json string"
+
+    # 6. ToolCalls instance passed
+    assert ToolCalls.validate_input(tc1) == tc1
