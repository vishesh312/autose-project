+def test_cleanup_timeout_validation():
+    cmd = click.Command("test")
+
+    # Positive values are allowed
+    ctx = click.Context(cmd, cleanup_timeout=5.0)
+    assert ctx.cleanup_timeout == 5.0
+    ctx = click.Context(cmd, cleanup_timeout=1)
+    assert ctx.cleanup_timeout == 1.0
+
+    # None is allowed (default)
+    ctx = click.Context(cmd, cleanup_timeout=None)
+    assert ctx.cleanup_timeout is None
+    ctx_default = click.Context(cmd)
+    assert ctx_default.cleanup_timeout is None
+
+    # Zero or negative values should raise ValueError
+    with pytest.raises(ValueError, match="positive float"):
+        click.Context(cmd, cleanup_timeout=0)
+    with pytest.raises(ValueError, match="positive float"):
+        click.Context(cmd, cleanup_timeout=-1.0)
+    with pytest.raises(ValueError, match="positive float"):
+        click.Context(cmd, cleanup_timeout="invalid")
+    with pytest.raises(ValueError, match="positive float"):
+        click.Context(cmd, cleanup_timeout=True)
+
+
+def test_cleanup_timeout_execution(caplog):
+    import time
+
+    cmd = click.Command("test")
+    ctx = click.Context(cmd, cleanup_timeout=0.05)
+
+    called = []
+
+    def hanging_cleanup():
+        called.append("start")
+        time.sleep(0.5)
+        called.append("end")
+
+    ctx.call_on_close(hanging_cleanup)
+
+    with caplog.at_level(logging.WARNING):
+        start_time = time.time()
+        ctx.close()
+        elapsed = time.time() - start_time
+
+    assert elapsed < 0.3
+    assert "start" in called
+    assert "end" not in called
+    assert any("Context cleanup operation exceeded timeout" in record.message for record in caplog.records)
+
+
+def test_cleanup_timeout_inheritance():
+    cmd = click.Group("cli")
+    sub_cmd = click.Command("sub")
+
+    parent = click.Context(cmd, cleanup_timeout=3.0)
+    child = click.Context(sub_cmd, parent=parent)
+    assert child.cleanup_timeout == 3.0
+
+    # Explicit override on child
+    child_override = click.Context(sub_cmd, parent=parent, cleanup_timeout=1.0)
+    assert child_override.cleanup_timeout == 1.0
+
+
