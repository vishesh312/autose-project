+def test_shell_completion_file_cleanup_no_warning(runner):
+    import warnings
+    import gc
+
+    @click.group()
+    @click.option("--file", type=click.File("r"))
+    def cli(file):
+        pass
+
+    @cli.command()
+    @click.option("--subfile", type=click.File("r"))
+    def sub(subfile):
+        pass
+
+    with runner.isolation():
+        with open("test.txt", "w") as f:
+            f.write("hello")
+
+        with warnings.catch_warnings(record=True) as recorded_warnings:
+            warnings.simplefilter("always")
+            comp = ShellComplete(cli, {}, "cli", "_CLI_COMPLETE")
+            comp.get_completions(["--file", "test.txt", "sub", "--subfile", "test.txt"], "")
+            del comp
+            gc.collect()
+
+        resource_warnings = [
+            w for w in recorded_warnings if issubclass(w.category, ResourceWarning)
+        ]
+        assert not resource_warnings
+
+
+def test_shell_completion_respects_cleanup_timeout():
+    import time
+
+    called = []
+
+    class HangingOption(Option):
+        def process_value(self, ctx, value):
+            @ctx.call_on_close
+            def hang():
+                called.append("start")
+                time.sleep(0.5)
+                called.append("end")
+            return super().process_value(ctx, value)
+
+    @click.command()
+    @click.option("--opt", cls=HangingOption)
+    def cli(opt):
+        pass
+
+    comp = ShellComplete(cli, {"cleanup_timeout": 0.05}, "cli", "_CLI_COMPLETE")
+    start_time = time.time()
+    comp.get_completions(["--opt", "val"], "")
+    elapsed = time.time() - start_time
+
+    assert elapsed < 0.3
+    assert "start" in called
+    assert "end" not in called
