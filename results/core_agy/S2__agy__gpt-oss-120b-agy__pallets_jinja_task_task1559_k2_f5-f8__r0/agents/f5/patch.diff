+    def _validate_trans_variables(
+        self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int
+    ) -> None:
+        """Validate all variables used in a trans block.
+
+        Checks that variable names are valid Python identifiers, do not clash
+        with built‑in gettext function names, and that their expression types are
+        appropriate for translation contexts.
+        """
+        for name, expr in variables.items():
+            # Name must be a valid identifier
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r} in trans block; variable names must be valid Python identifiers.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Reserved gettext function names
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            # Validate the expression
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self, name: str, expr: nodes.Expr, parser: "Parser", lineno: int
+    ) -> None:
+        """Validate a single variable expression.
+
+        Allowed expression node types are limited to those that can be safely
+        serialized for gettext/ngettext calls: ``Const``, ``Name``, ``Call``
+        (where the callee is a simple name or attribute), ``Getattr``, ``Filter``
+        and ``Test``.  Anything else – especially ``TemplateData`` or ``Output`` –
+        is rejected with a clear error message.
+        """
+        # Directly acceptable node types
+        if isinstance(expr, (nodes.Const, nodes.Name, nodes.Getattr, nodes.Filter, nodes.Test)):
+            return
+        if isinstance(expr, nodes.Call):
+            # The function being called must be a Name or Getattr
+            if isinstance(expr.node, (nodes.Name, nodes.Getattr)):
+                return
+        # Anything else is invalid
+        parser.fail(
+            f"Invalid expression for variable {name!r} in trans block; expression type {type(expr).__name__} is not allowed.",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
 
