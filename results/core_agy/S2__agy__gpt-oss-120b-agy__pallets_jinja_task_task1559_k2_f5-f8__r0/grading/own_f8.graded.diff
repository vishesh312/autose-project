-class InternationalizationExtension(Extension):
+class ConditionalI18nExtension(InternationalizationExtension):
+    """Conditional translation tag ``ctrans``.
+
+    Syntax::
+
+        {% ctrans condition [variables] [trimmed|notrimmed] %}
+            ... singular ...
+        {% pluralize [variable] %}
+            ... plural ...
+        {% fallback %}
+            ... fallback content ...
+        {% endctrans %}
+
+    The ``condition`` is a boolean expression evaluated at render time. If true,
+    the standard translation rendering (gettext/ngettext) is performed. If false,
+    the ``fallback`` block is rendered instead.  The implementation mirrors the
+    existing :class:`InternationalizationExtension` but adds a conditional branch
+    and requires a ``fallback`` block.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.Node:
+        lineno = next(parser.stream).lineno
+        # parse condition expression
+        condition = parser.parse_expression()
+
+        # parse optional variable declarations and trimming flags
+        num_called_num = False
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if variables:
+                parser.stream.expect("comma")
+            if parser.stream.skip_if("colon"):
+                break
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+        parser.stream.expect("block_end")
+
+        # parse singular block
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names:
+            for name in singular_names:
+                if name not in variables:
+                    variables[name] = nodes.Name(name, "load")
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+                num_called_num = singular_names[0] == "num"
+
+        # parse optional pluralize block
+        plural = None
+        have_plural = False
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            for name in plural_names:
+                if name not in variables:
+                    variables[name] = nodes.Name(name, "load")
+        else:
+            # consume the endctrans later
+            pass
+
+        # after plural (or not), expect fallback block
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block", lineno, exc=TemplateSyntaxError)
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback_content = self._parse_block(parser, False)
+        # ensure endctrans
+        if not parser.stream.current.test("name:endctrans"):
+            parser.fail("unclosed conditional translation block", lineno, exc=TemplateSyntaxError)
+        next(parser.stream)
+        parser.stream.expect("block_end")
+
+
+        # trimming handling (apply to all blocks)
+        if trimmed is None:
+            trimmed = self.environment.policies["ext.i18n.trimmed"]
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+            fallback_content = self._trim_whitespace(fallback_content)
+
+        # create translation node (same as _make_node)
+        trans_node = self._make_node(
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(singular_names or plural),
+            num_called_num and have_plural,
+        )
+        trans_node.set_lineno(lineno)
+        if plural_expr_assignment is not None:
+            trans_node = [plural_expr_assignment, trans_node]
+
+        # create fallback node – simple constant output with autoescaping
+        fallback_node: nodes.Node
+        fallback_node = nodes.Const(fallback_content)
+        fallback_node = nodes.MarkSafeIfAutoescape(fallback_node)
+        fallback_node.set_lineno(lineno)
+
+        # conditional if node
+
+-        if_node = nodes.If(test_node, [trans_node] if isinstance(trans_node, nodes.Node) else trans_node, [fallback_node])
++        # Ensure body is a list of nodes
++        if isinstance(trans_node, list):
++            body_nodes = trans_node
++        else:
++            body_nodes = [trans_node]
++        if_node = nodes.If(test_node, body_nodes, [fallback_node])
+         if_node.set_lineno(lineno)
+         return if_node
+
+
+    """Existing InternationalizationExtension handling {% trans %} tags."""
+    # unchanged implementation
+
     """This extension adds gettext support to Jinja."""
 
     tags = {"trans"}
