+class TestConditionalI18n:
+    def test_basic_rendering(self):
+        env = Environment(extensions=["jinja2.ext.conditional_i18n", "jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: "translated: " + s,
+            lambda s, p, n: f"translated: {s if n == 1 else p}",
+        )
+        tmpl = env.from_string(
+            "{% ctrans cond %}hello{% fallback %}world{% endctrans %}"
+        )
+        assert tmpl.render(cond=True) == "translated: hello"
+        assert tmpl.render(cond=False) == "world"
+
+    def test_variable_substitution(self):
+        env = Environment(extensions=["jinja2.ext.conditional_i18n", "jinja2.ext.i18n"])
+        env.install_gettext_callables(
+            lambda s: s,
+            lambda s, p, n: s if n == 1 else p,
+        )
+        tmpl = env.from_string(
+            '{% ctrans cond, name="Alice" %}hello {{ name }}{% fallback %}goodbye {{ name }}{% endctrans %}'
+        )
+        assert tmpl.render(cond=True) == "hello Alice"
+        assert tmpl.render(cond=False) == "goodbye Alice"
+
+    def test_optional_commas(self):
+        env = Environment(extensions=["jinja2.ext.conditional_i18n", "jinja2.ext.i18n"])
+        env.install_null_translations()
+        tmpl1 = env.from_string(
+            "{% ctrans cond count=5 %}count is {{ count }}{% fallback %}no count{% endctrans %}"
+        )
+        assert tmpl1.render(cond=True) == "count is 5"
+        tmpl2 = env.from_string(
+            "{% ctrans cond, count=5 %}count is {{ count }}{% fallback %}no count{% endctrans %}"
+        )
+        assert tmpl2.render(cond=True) == "count is 5"
+
+    def test_pluralize(self):
