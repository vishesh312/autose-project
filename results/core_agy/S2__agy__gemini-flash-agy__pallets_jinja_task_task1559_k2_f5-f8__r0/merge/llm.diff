+    def test_trans_variable_validation(self):
+        from jinja2.exceptions import TemplateSyntaxError
+        from jinja2.parser import Parser
+
+        ext = i18n_env.extensions["jinja2.ext.InternationalizationExtension"]
+        parser = Parser(i18n_env, "")
+
+        # Invalid variable name (not a Python identifier) tested via _validate_trans_variables
+        with pytest.raises(TemplateSyntaxError, match=r"Invalid variable name.*Python identifiers"):
+            ext._validate_trans_variables({"123bad": nodes.Const(1)}, parser, 1)
+
+        with pytest.raises(TemplateSyntaxError, match=r"Invalid variable name.*Python identifiers"):
+            ext._validate_trans_variables({"bad-name": nodes.Const(1)}, parser, 1)
+
+        # Reserved translation function names conflict
+        for reserved in ("gettext", "ngettext", "pgettext", "npgettext", "_"):
+            with pytest.raises(
+                TemplateSyntaxError,
+                match=r"conflicts with translation function names",
+            ):
+                i18n_env.from_string(f"{{% trans {reserved}=1 %}}hello{{% endtrans %}}")
+
+            with pytest.raises(
+                TemplateSyntaxError,
+                match=r"conflicts with translation function names",
+            ):
+                i18n_env.from_string(f"{{% trans %}}hello {{{{ {reserved} }}}}{{% endtrans %}}")
+
+        # Incompatible expression types (template data, output, etc.)
+        with pytest.raises(TemplateSyntaxError, match=r"translation contexts"):
+            i18n_env.from_string("{% trans foo=bar + 1 %}hello {{ foo }}{% endtrans %}")
+
+        with pytest.raises(TemplateSyntaxError, match=r"translation contexts"):
+            i18n_env.from_string("{% trans foo=bar[0] %}hello {{ foo }}{% endtrans %}")
+
+        # Complex call (not simple function call with Name)
+        with pytest.raises(TemplateSyntaxError, match=r"translation contexts"):
+            i18n_env.from_string("{% trans foo=bar()() %}hello {{ foo }}{% endtrans %}")
+
+        with pytest.raises(TemplateSyntaxError, match=r"translation contexts"):
+            i18n_env.from_string("{% trans foo=bar.baz() %}hello {{ foo }}{% endtrans %}")
+
+        # Incompatible expression AST node directly
+        with pytest.raises(TemplateSyntaxError, match=r"template data.*translation contexts"):
+            ext._validate_trans_expression("test_var", nodes.TemplateData("data"), parser, 1)
+        with pytest.raises(TemplateSyntaxError, match=r"template data.*translation contexts"):
+            ext._validate_trans_expression("test_var", nodes.Output([]), parser, 1)
+
+        # Valid expressions: Const, Name, simple Call, Getattr, Filter, Test
+        tmpl = i18n_env.from_string(
+            "{% trans s='str', n=42, b=true, v=x, call=get_val(), attr=x.y, filt=x|upper, t=x is defined %}"
+            "{{ s }} {{ n }} {{ b }} {{ v }} {{ call }} {{ attr }} {{ filt }} {{ t }}"
+            "{% endtrans %}"
+        )
+        assert tmpl.render(
+            x=type("Obj", (), {"y": "val", "__str__": lambda self: "obj"})(),
+            get_val=lambda: "called",
+        ) == "str 42 True obj called val OBJ True"
+
+        # Pluralize and trimmed with validation
+        tmpl_plural = i18n_env.from_string(
+            "{% trans trimmed count=get_val() %}"
+            "{{ count }} item"
+            "{% pluralize %}"
+            "{{ count }} items"
+            "{% endtrans %}"
+        )
+        assert tmpl_plural.render(get_val=lambda: 3) == "3 items"
