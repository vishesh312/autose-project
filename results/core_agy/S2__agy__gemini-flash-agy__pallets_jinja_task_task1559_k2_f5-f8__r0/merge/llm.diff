+        tmpl = env.from_string(
+            "{% ctrans cond, count %}{{ count }} user{% pluralize %}{{ count }} users{% fallback %}{{ count }} fallback{% endctrans %}"
+        )
+        assert tmpl.render(cond=True, count=1) == "de: 1 user"
+        assert tmpl.render(cond=True, count=5) == "de: 5 users"
+        assert tmpl.render(cond=False, count=1) == "1 fallback"
+        assert tmpl.render(cond=False, count=5) == "5 fallback"
