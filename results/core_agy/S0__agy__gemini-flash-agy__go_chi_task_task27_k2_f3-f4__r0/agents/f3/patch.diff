+func TestEnableDebugLogging(t *testing.T) {
+	var buf bytes.Buffer
+	origOutput := log.Writer()
+	origFlags := log.Flags()
+	origPrefix := log.Prefix()
+	log.SetOutput(&buf)
+	log.SetFlags(0)
+	log.SetPrefix("")
+	defer func() {
+		log.SetOutput(origOutput)
+		log.SetFlags(origFlags)
+		log.SetPrefix(origPrefix)
+		debugLogging = false
+	}()
+
+	r := NewRouter()
+	r.Handle("/no-debug", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	if buf.Len() > 0 {
+		t.Errorf("expected no debug logging before EnableDebugLogging, got: %s", buf.String())
+	}
+
+	EnableDebugLogging()
+
+	r.Handle("/user/{id}", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	if !strings.Contains(buf.String(), "parsed pattern without method: /user/{id}") {
+		t.Errorf("expected log message for pattern without method, got: %s", buf.String())
+	}
+	buf.Reset()
+
+	r.Handle("POST /products/{id}", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	if !strings.Contains(buf.String(), "parsed pattern with method: method=POST, path=/products/{id}") {
+		t.Errorf("expected log message for pattern with method, got: %s", buf.String())
+	}
+	buf.Reset()
+
+	r.HandleFunc("GET /items/{id}", func(w http.ResponseWriter, r *http.Request) {})
+	if !strings.Contains(buf.String(), "parsed pattern with method: method=GET, path=/items/{id}") {
+		t.Errorf("expected log message for HandleFunc with method, got: %s", buf.String())
+	}
+	buf.Reset()
+
+	r.HandleFunc("/items", func(w http.ResponseWriter, r *http.Request) {})
+	if !strings.Contains(buf.String(), "parsed pattern without method: /items") {
+		t.Errorf("expected log message for HandleFunc without method, got: %s", buf.String())
+	}
+	buf.Reset()
+
+	func() {
+		defer func() {
+			_ = recover()
+		}()
+		r.Handle("INVALID /path", http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	}()
+	if !strings.Contains(buf.String(), "invalid HTTP method detected: INVALID") {
+		t.Errorf("expected log message for invalid method in Handle, got: %s", buf.String())
+	}
+	buf.Reset()
+
+	func() {
+		defer func() {
+			_ = recover()
+		}()
+		r.HandleFunc("BADMETHOD /path", func(w http.ResponseWriter, r *http.Request) {})
+	}()
+	if !strings.Contains(buf.String(), "invalid HTTP method detected: BADMETHOD") {
+		t.Errorf("expected log message for invalid method in HandleFunc, got: %s", buf.String())
+	}
+}
