 class ToolCalls(Type):
+    class ToolCall(BaseModel):
+        name: str
+        args: dict[str, Any]
+        # Fingerprint attributes (read‑only after creation)
+        fingerprint: str | None = None
+        id: str | None = None
+
+        def __init__(self, **data: Any):
+            super().__init__(**data)
+            # Compute deterministic fingerprint
+            canonical_args = _canonicalize(self.args)
+            canonical_obj = {"name": self.name, "args": canonical_args}
+            canonical_json = json.dumps(canonical_obj, sort_keys=True, separators=(",", ":"))
+            fp = hashlib.sha256(canonical_json.encode()).hexdigest()
+            # Assign read‑only attributes
+            object.__setattr__(self, "fingerprint", fp)
+            object.__setattr__(self, "id", fp[:8])
+
+    tool_calls: list[ToolCall]
+
+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Validate and normalize various LM output formats for tool calls.
+
+        Supported inputs:
+        * JSON string representing a dict or list.
+        * dict with a ``tool_calls`` key containing a list of calls.
+        * dict with ``name`` and ``args`` keys (single call).
+        * list of dicts each with ``name``/``args`` (bare list).
+        * Any other value is returned unchanged.
+        """
+        # Try parsing JSON strings
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+                return cls.validate_input(parsed)
+            except Exception:
+                return data
+        # Dict handling
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if "name" in data and "args" in data:
+                return {"tool_calls": [{"name": data["name"], "args": data["args"]}]}
+            # Unknown dict, return as‑is
+            return data
+        # List handling (bare list of calls)
+        if isinstance(data, list):
+            # Assume list of dicts with name/args
+            return {"tool_calls": data}
+        # Fallback
+        return data
+
+    @classmethod
+    def from_dict_list(cls, tool_calls_dicts: list[dict[str, Any]]) -> "ToolCalls":
+        """Convert a list of dictionaries to a ToolCalls instance.
+
+        Args:
+            dict_list: A list of dictionaries, where each dictionary should have 'name' and 'args' keys.
+
+        Returns:
+            A ToolCalls instance.
+        """
+        tool_calls = [cls.ToolCall(**item) for item in tool_calls_dicts]
+        return cls(tool_calls=tool_calls)
+
+    @classmethod
+    def description(cls) -> str:
+        return (
+            "Tool calls information, including the name of the tools and the arguments to be passed to it. "
+            "Arguments must be provided in JSON format."
+        )
+
