+def _canonicalize(value: Any) -> Any:
+    """Recursively canonicalize a value for fingerprinting.
+
+    - Convert tuples to lists.
+    - Trim whitespace from strings.
+    - Sort dictionary keys recursively.
+    - Preserve numeric, boolean, and None types.
+    """
+    if isinstance(value, tuple):
+        return [_canonicalize(v) for v in value]
+    if isinstance(value, list):
+        return [_canonicalize(v) for v in value]
+    if isinstance(value, dict):
+        # sort keys by default when dumping, but produce a dict with sorted keys for consistency
+        return {k: _canonicalize(value[k]) for k in sorted(value)}
+    if isinstance(value, str):
+        return value.strip()
+    # primitives (int, float, bool, None) remain unchanged
+    return value
+
