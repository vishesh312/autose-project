+def _canonicalize(value: Any) -> Any:
+    """Recursively canonicalize arguments:
+    - Sort dict keys
+    - Convert tuples to lists
+    - Strip whitespace from strings
+    """
+    if isinstance(value, dict):
+        # sort keys and canonicalize values
+        return {k: _canonicalize(value[k]) for k in sorted(value)}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize(v) for v in list(value)]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
 class ToolCalls(Type):
     class ToolCall(BaseModel):
         name: str
         args: dict[str, Any]
+        fingerprint: str = Field(default="")
+        id: str = Field(default="")
+
+        @model_validator(mode='after')
+        def _compute_fingerprint(self):
+            # Compute fingerprint and id after model initialization
+            name = self.name
+            args = self.args or {}
+            canonical_args = _canonicalize(args)
+            payload = {'name': name, 'args': canonical_args}
+            json_str = json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()
+            fp = hashlib.sha256(json_str).hexdigest()
+            object.__setattr__(self, 'fingerprint', fp)
+            object.__setattr__(self, 'id', fp[:8])
+            return self
