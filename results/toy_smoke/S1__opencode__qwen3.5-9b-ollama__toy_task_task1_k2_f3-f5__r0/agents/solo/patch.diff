+"""Slug generation utilities."""
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Convert text to a URL-friendly slug.
+    
+    Lowercases the text, replaces every run of non-ASCII letters or digits with sep,
+    and strips leading/trailing separators.
+    
+    Args:
+        text: The input text to convert.
+        sep: The separator character (default: "-").
+    
+    Returns:
+        A slugified string.
+    
+    Examples:
+        >>> slugify("  Hello, World!! ")
+        'hello-world'
+        >>> slugify("A B", sep="_")
+        'a_b'
+    """
+    # Replace runs of non-ASCII letters/digits with a single separator
+    # Then collapse multiple consecutive separators into one
+    
+    lowercase = text.lower()
+    
+    # First pass: replace any non-alphanum character with the separator
+    processed_chars = []
+    for c in lowercase:
+        if c.isascii() and (c.isalpha() or c.isdigit()):
+            processed_chars.append(c)
+        else:
+            processed_chars.append(sep)
+    
+    # Second pass: collapse consecutive separators into one
+    collapsed = []
+    prev_was_sep = False
+    for c in processed_chars:
+        if c == sep and prev_was_sep:
+            continue  # skip duplicate separator
+        collapsed.append(c)
+        prev_was_sep = (c == sep)
+    
+    slug = "".join(collapsed)
+    
+    # Strip leading/trailing separators
+    return slug.strip(sep)
