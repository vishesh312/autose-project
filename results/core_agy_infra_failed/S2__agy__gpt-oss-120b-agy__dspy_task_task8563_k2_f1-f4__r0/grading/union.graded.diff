+        @staticmethod
+        def _canonicalize(value: Any) -> Any:
+            """Recursively canonicalize arguments:
+            - Sort dict keys.
+            - Convert tuples to lists.
+            - Strip whitespace from strings.
+            """
+            if isinstance(value, dict):
+                return {k: ToolCalls.ToolCall._canonicalize(value[k]) for k in sorted(value)}
+            if isinstance(value, (list, tuple)):
+                return [ToolCalls.ToolCall._canonicalize(item) for item in list(value)]
+            if isinstance(value, str):
+                return value.strip()
+            return value
+
+        @classmethod
+        def _compute_fingerprint(cls, name: str, args: dict[str, Any]) -> str:
+            canonical_args = cls._canonicalize(args)
+            obj = {"name": name, "args": canonical_args}
+            canonical_json = json.dumps(obj, sort_keys=True, separators=(",", ":"))
+            return hashlib.sha256(canonical_json.encode()).hexdigest()
+
+        @classmethod
+        def _compute_id(cls, fingerprint: str) -> str:
+            return fingerprint[:8]
+
+        @staticmethod
+        def _add_fingerprint_and_id(values: dict[str, Any]) -> dict[str, Any]:
+            name = values.get("name")
+            args = values.get("args", {})
+            fingerprint = ToolCalls.ToolCall._compute_fingerprint(name, args)
+            values["fingerprint"] = fingerprint
+            values["id"] = ToolCalls.ToolCall._compute_id(fingerprint)
+            return values
+
+        @classmethod
+        def __get_validators__(cls):
+            yield from super().__get_validators__()
