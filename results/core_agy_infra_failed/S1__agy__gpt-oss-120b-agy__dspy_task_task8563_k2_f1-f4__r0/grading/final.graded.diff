+        @staticmethod
+        def _canonicalize(value: Any) -> Any:
+            if isinstance(value, dict):
+                return {k: ToolCalls.ToolCall._canonicalize(value[k]) for k in sorted(value)}
+            if isinstance(value, (list, tuple)):
+                return [ToolCalls.ToolCall._canonicalize(v) for v in list(value)]
+            if isinstance(value, str):
