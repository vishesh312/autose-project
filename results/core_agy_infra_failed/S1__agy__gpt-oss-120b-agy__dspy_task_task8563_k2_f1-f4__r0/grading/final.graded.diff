+        def __init__(self, **data):
+            super().__init__(**data)
+            # Compute canonical representation for fingerprint
+            canonical_args = self._canonicalize(self.args)
+            canonical_obj = {"name": self.name, "args": canonical_args}
+            import json, hashlib
+            canonical_str = json.dumps(canonical_obj, sort_keys=True, separators=(",", ":"))
+            fp = hashlib.sha256(canonical_str.encode()).hexdigest()
+            object.__setattr__(self, "fingerprint", fp)
+            object.__setattr__(self, "id", fp[:8])
