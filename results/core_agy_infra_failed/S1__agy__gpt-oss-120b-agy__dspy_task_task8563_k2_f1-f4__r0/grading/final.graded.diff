+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize various LM output formats for tool calls.
+
+        Returns one of:
+        - dict with 'tool_calls' key containing list of calls
+        - single dict with 'name' and 'args'
+        - list of such dicts
+        - raw string if not JSON parsable
+        """
+        import json
+        # If already a dict or list, handle directly
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+        if isinstance(data, list):
+            return {"tool_calls": data}
+        # If string, try JSON parsing
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+                return cls.validate_input(parsed)
+            except Exception:
+                return data
+        return data
