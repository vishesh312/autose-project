+                raise TimeoutError("Context cleanup timed out")
+            previous_handler = signal.getsignal(signal.SIGALRM)
+            signal.signal(signal.SIGALRM, _handle_timeout)
+            # Convert timeout to integer seconds for alarm (minimum 1 sec)
