diff --git a/tests/test_loader.py b/tests/test_loader.py
index b300c8f..dcaa272 100644
--- a/tests/test_loader.py
+++ b/tests/test_loader.py
@@ -26,6 +26,49 @@ class TestLoaders:
         assert tmpl.render().strip() == "FOO"
         pytest.raises(TemplateNotFound, env.get_template, "missing.html")
 
+    def test_path_aliasing(self):
+        loader = loaders.DictLoader({"template.html": "Hello {{ name }}!"})
+        loader.add_alias("main.html", "template.html")
+        loader.add_alias("index.html", "template.html")
+
+        env = Environment(loader=loader)
+        # All three should work identically
+        assert env.get_template("template.html").render(name="world") == "Hello world!"
+        assert env.get_template("main.html").render(name="world") == "Hello world!"
+        assert env.get_template("index.html").render(name="world") == "Hello world!"
+
+        # Alias removal
+        loader.remove_alias("main.html")
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("main.html")
+        assert exc_info.value.name == "main.html"
+
+        # Safe removal of non-existent alias
+        loader.remove_alias("nonexistent_alias")
+
+        # Error handling: alias to non-existent template
+        loader.add_alias("broken.html", "nonexistent.html")
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("broken.html")
+        assert exc_info.value.name == "nonexistent.html"
+
+        # Aliases should not chain (no recursive resolution)
+        loader.add_alias("alias1", "alias2")
+        loader.add_alias("alias2", "template.html")
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("alias1")
+        assert exc_info.value.name == "alias2"
+
+        # Overwriting alias
+        loader.add_alias("broken.html", "template.html")
+        assert env.get_template("broken.html").render(name="world") == "Hello world!"
+
+        # Special characters and empty string as alias name
+        loader.add_alias("", "template.html")
+        assert env.get_template("").render(name="world") == "Hello world!"
+        loader.add_alias("!@#$%^&*()_+ space", "template.html")
+        assert env.get_template("!@#$%^&*()_+ space").render(name="world") == "Hello world!"
+
     def test_package_loader(self, package_loader):
         env = Environment(loader=package_loader)
         tmpl = env.get_template("test.html")
