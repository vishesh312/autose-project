+class TestPathTransform:
+    def test_dict_loader_path_transform(self):
+        templates = {"index.html": "Home Page", "about.html": "About Us"}
+
+        def alias_transform(template):
+            aliases = {"home": "index.html", "about": "about.html"}
+            return aliases.get(template, template)
+
+        loader = loaders.DictLoader(templates, path_transform=alias_transform)
+        env = Environment(loader=loader)
+
+        assert env.get_template("home").render() == "Home Page"
+        assert env.get_template("about").render() == "About Us"
+        assert env.get_template("index.html").render() == "Home Page"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("missing")
+        assert exc_info.value.name == "missing"
+
+    def test_filesystem_loader_path_transform(self, filesystem_loader):
+        def normalize_path(template):
+            return template.lstrip("/").replace("\\", "/")
+
+        loader = loaders.FileSystemLoader(
+            filesystem_loader.searchpath, path_transform=normalize_path
+        )
+        env = Environment(loader=loader)
+
+        tmpl = env.get_template("/test.html")
+        assert tmpl.render().strip() == "BAR"
+
+        tmpl2 = env.get_template(r"\test.html")
+        assert tmpl2.render().strip() == "BAR"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("/nonexistent.html")
+        assert exc_info.value.name == "/nonexistent.html"
+
+    def test_package_loader_path_transform(self):
+        def transform(template):
+            if template == "main":
+                return "test.html"
+            return template
+
+        loader = loaders.PackageLoader("res", "templates", path_transform=transform)
+        env = Environment(loader=loader)
+
+        assert env.get_template("main").render().strip() == "BAR"
+        assert env.get_template("test.html").render().strip() == "BAR"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("missing")
+        assert exc_info.value.name == "missing"
+
+    def test_function_loader_path_transform(self):
+        store = {"real.html": "FUNCTION_SOURCE"}
+
+        def transform(template):
+            return f"{template}.html"
+
+        loader = loaders.FunctionLoader(store.get, path_transform=transform)
+        env = Environment(loader=loader)
+
+        assert env.get_template("real").render() == "FUNCTION_SOURCE"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("missing")
+        assert exc_info.value.name == "missing"
+
+    def test_prefix_loader_path_transform(self):
+        # PrefixLoader should apply path_transform at top level before splitting delimiter
+        dict1 = loaders.DictLoader({"index.html": "App1 Index"})
+        dict2 = loaders.DictLoader({"index.html": "App2 Index"})
+
+        def transform(template):
+            if template.startswith("v1/"):
+                return "app1/" + template[3:]
+            return template
+
+        loader = loaders.PrefixLoader(
+            {"app1": dict1, "app2": dict2}, path_transform=transform
+        )
+        env = Environment(loader=loader)
+
+        assert env.get_template("v1/index.html").render() == "App1 Index"
+        assert env.get_template("app2/index.html").render() == "App2 Index"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("v1/missing.html")
+        assert exc_info.value.name == "v1/missing.html"
+
+        # Also testing when loader.get_source is called directly
+        with pytest.raises(TemplateNotFound) as exc_info:
+            loader.get_source(env, "v1/missing.html")
+        assert exc_info.value.name == "v1/missing.html"
+
+    def test_choice_loader_path_transform(self):
+        loader1 = loaders.DictLoader({"a.html": "Loader 1"})
+        loader2 = loaders.DictLoader({"b.html": "Loader 2"})
+
+        def transform(template):
+            if template == "first":
+                return "a.html"
+            elif template == "second":
+                return "b.html"
+            return template
+
+        choice = loaders.ChoiceLoader([loader1, loader2], path_transform=transform)
+        env = Environment(loader=choice)
+
+        assert env.get_template("first").render() == "Loader 1"
+        assert env.get_template("second").render() == "Loader 2"
+
+        with pytest.raises(TemplateNotFound) as exc_info:
+            env.get_template("third")
+        assert exc_info.value.name == "third"
+
+        # Test get_source directly
+        source, _, _ = choice.get_source(env, "first")
+        assert source == "Loader 1"
+        with pytest.raises(TemplateNotFound) as exc_info:
+            choice.get_source(env, "missing")
+        assert exc_info.value.name == "missing"
+
+    def test_empty_string_transform(self):
+        loader = loaders.DictLoader(
+            {"default.html": "DEFAULT"},
+            path_transform=lambda t: "default.html" if t == "" else t,
+        )
+        env = Environment(loader=loader)
+        assert env.get_template("").render() == "DEFAULT"
+
+    def test_exception_propagation(self):
+        def error_transform(template):
+            raise CustomError("transform failed")
+
+        class CustomError(Exception):
+            pass
+
+        loader = loaders.DictLoader({"index.html": "INDEX"}, path_transform=error_transform)
+        env = Environment(loader=loader)
+
+        with pytest.raises(CustomError, match="transform failed"):
+            env.get_template("index.html")
+
+    def test_null_transform_backward_compatibility(self):
+        loader1 = loaders.DictLoader({"index.html": "INDEX"})
+        loader2 = loaders.DictLoader({"index.html": "INDEX"}, path_transform=None)
+
+        assert loader1.path_transform is None
+        assert loader2.path_transform is None
+
+        env1 = Environment(loader=loader1)
+        env2 = Environment(loader=loader2)
+
+        assert env1.get_template("index.html").render() == "INDEX"
+        assert env2.get_template("index.html").render() == "INDEX"
+
