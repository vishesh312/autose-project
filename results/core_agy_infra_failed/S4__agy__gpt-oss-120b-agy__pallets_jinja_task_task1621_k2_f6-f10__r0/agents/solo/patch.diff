+    def __init__(self, path_transform: t.Optional[t.Callable[[str], str]] = None) -> None:
+        """Initialize loader with optional path transformation function."""
+        self._path_transform = path_transform
+        self._aliases: t.Dict[str, str] = {}
+
+    def _resolve_template(self, template: str) -> str:
+        """Apply alias mapping and optional path transformation.
+        Alias resolution does not chain.
+        """
+        if template in self._aliases:
+            template = self._aliases[template]
+        if self._path_transform is not None:
+            template = self._path_transform(template)
+        return template
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Add or update an alias mapping."""
+        self._aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias if it exists."""
+        self._aliases.pop(alias, None)
