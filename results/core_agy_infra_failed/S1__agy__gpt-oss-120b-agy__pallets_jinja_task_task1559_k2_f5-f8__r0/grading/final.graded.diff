+class ConditionalI18nExtension(InternationalizationExtension):
+    """Conditional translation rendering with fallback support.
+
+    Syntax::
+        {% ctrans condition [variables] [trimmed|notrimmed] %}
+            ... translatable content ...
+        {% pluralize ... %}   # optional plural support not implemented in this simplified version
+        {% fallback %}
+            ... fallback content ...
+        {% endctrans %}
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.Node:
+        lineno = next(parser.stream).lineno
+        # Parse the condition expression
+        condition = parser.parse_expression()
+        # Parse optional variable declarations and trimming modifiers
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if variables:
+                parser.stream.expect("comma")
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = nodes.Name(token.value, "load")
+        parser.stream.expect("block_end")
+        # Validate variables like normal trans tag
+        self._validate_trans_variables(variables, parser, lineno)
+        # Parse the translatable block (singular)
+        singular_names, singular = self._parse_block(parser, True)
+        # Register referenced variables from the body
+        for name in singular_names:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+        # Parse mandatory fallback block
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block", parser.stream.current.lineno, exc=TemplateSyntaxError)
+        next(parser.stream)  # consume 'fallback'
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, False)
+        # Ensure endctrans
+        if not parser.stream.current.test("name:endctrans"):
+            parser.fail("unclosed conditional translation block", parser.stream.current.lineno, exc=TemplateSyntaxError)
+        next(parser.stream)  # consume 'endctrans'
+        # Build translation node for singular part (no plural handling here)
+        trans_node = self._make_node(
+            singular,
+            None,
+            variables,
+            None,
+            bool(singular_names),
+            False,
+        )
+        # Build fallback output node
+        fallback_node = nodes.Output([nodes.TemplateData(fallback)])
+        # Build conditional If node
+        if_node = nodes.If(test=condition, body=[trans_node], else_= [fallback_node])
+        if_node.set_lineno(lineno)
+        return if_node
+
+# Alias for compatibility
+conditional_i18n = ConditionalI18nExtension
+
+
     """Adds a `do` tag to Jinja that works like the print statement just
     that it doesn't print the return value.
     """
