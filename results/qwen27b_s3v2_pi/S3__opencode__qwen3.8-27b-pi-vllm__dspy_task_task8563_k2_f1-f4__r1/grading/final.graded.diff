+def _canonicalize(value: Any) -> Any:
+    """Recursively canonicalize a value for stable fingerprinting.
+
+    - Sorts dictionary keys.
+    - Converts tuples to lists.
+    - Strips leading/trailing whitespace from string values.
+    - Leaves numeric and boolean types unchanged.
+    """
+    if isinstance(value, dict):
+        return {k: _canonicalize(v) for k, v in sorted(value.items())}
+    if isinstance(value, tuple):
+        return [_canonicalize(item) for item in value]
+    if isinstance(value, list):
+        return [_canonicalize(item) for item in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
+
+def _compute_fingerprint(name: str, args: dict[str, Any]) -> str:
+    """Compute a stable SHA-256 fingerprint for a tool call from its name and canonicalized args."""
+    canonical = {"name": name, "args": _canonicalize(args)}
+    canonical_str = json.dumps(canonical, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(canonical_str.encode("utf-8")).hexdigest()
+
