+    @classmethod
+    def validate_input(cls, data: Any) -> Any:
+        """Normalize varied LM output formats into the expected ``tool_calls`` structure.
+
+        Handles the following input shapes and returns plain Python structures
+        (dict / list / str) suitable for constructing a ``ToolCalls`` model:
+
+        * ``{"tool_calls": [...]}``           – returned unchanged
+        * ``{"name": ..., "args": ...}``      – wrapped as ``{"tool_calls": [item]}``
+        * ``[{"name": ..., "args": ...}, ...]`` – wrapped as ``{"tool_calls": list}``
+        * JSON string encoding any of the above – parsed, then normalised
+        * non-JSON string                      – returned unchanged
+        """
+        if isinstance(data, cls):
+            return {"tool_calls": [tc.model_dump() for tc in data.tool_calls]}
+
+        if isinstance(data, str):
+            stripped = data.strip()
+            if not (stripped.startswith("{") or stripped.startswith("[")):
+                return data
+            try:
+                data = json.loads(stripped)
+            except (json.JSONDecodeError, ValueError):
+                return data
+
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list):
+            return {"tool_calls": data}
+
+        return data
+
