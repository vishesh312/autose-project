+    def validate_input(cls, data: Any) -> Any:
+        """Normalize the varied LM output formats for tool calls into the canonical structure.
+
+        Language models frequently emit ``dspy.ToolCalls`` in alternative shapes that deviate from the
+        canonical ``{"tool_calls": [{"name": ..., "args": ...}, ...]}`` structure, e.g. a single tool-call
+        object ``{"name": ..., "args": ...}`` or a bare list ``[{"name": ..., "args": ...}, ...]``. This
+        validator normalizes all of those into the expected internal format without changing semantics.
+
+        It returns normalized Python structures (a dict, list, or string) rather than a ``ToolCalls``
+        instance, so that Pydantic can build the model from the result:
+
+        - A dict that already contains the ``tool_calls`` key is returned unchanged.
+        - A single ``{"name": ..., "args": ...}`` dict is wrapped into ``{"tool_calls": [<dict>]}``.
+        - A list of such dicts is wrapped into ``{"tool_calls": <list>}``.
+        - A JSON string is parsed first; the parsed dict/list is then normalized as above. A string that
+          cannot be parsed as JSON is returned unchanged.
+        """
+        if isinstance(data, cls):
+            return {"tool_calls": [tool_call.model_dump() for tool_call in data.tool_calls]}
+
+        if isinstance(data, str):
+            try:
+                parsed = json.loads(data)
+            except (json.JSONDecodeError, ValueError):
+                return data
+            if not isinstance(parsed, (dict, list)):
+                # A bare JSON scalar (e.g. "123", "null") is not a tool-call structure.
+                return data
+            data = parsed
+
+        if isinstance(data, dict):
+            # Canonical form: process as before.
+            if "tool_calls" in data:
+                return data
+            # A single tool-call object without the outer `tool_calls` key.
+            if "name" in data and "args" in data:
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list):
+            # A bare list of tool-call objects.
+            return {"tool_calls": data}
+
+        return data
