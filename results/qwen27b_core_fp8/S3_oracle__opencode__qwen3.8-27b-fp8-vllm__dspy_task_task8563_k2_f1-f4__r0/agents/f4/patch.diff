+def _canonicalize_tool_call_args(args: Any) -> Any:
+    """Recursively canonicalize tool call args so equivalent data has one consistent representation.
+
+    - Dict keys are sorted (recursively).
+    - Tuples are converted to lists.
+    - Leading/trailing whitespace is stripped from string values.
+    - All other values (numbers, booleans, ``None``, etc.) are preserved unchanged, without any
+      type coercion beyond the string trimming.
+    """
+    if isinstance(args, dict):
+        return {key: _canonicalize_tool_call_args(args[key]) for key in sorted(args, key=str)}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_tool_call_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
+
+def _tool_call_fingerprint(name: str, args: dict[str, Any]) -> str:
+    """Compute a stable SHA-256 fingerprint for a tool call from its name and canonicalized args."""
+    canonical = {
+        "name": name,
+        "args": _canonicalize_tool_call_args(args),
+    }
+    canonical_json = json.dumps(canonical, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(canonical_json.encode("utf-8")).hexdigest()
+
