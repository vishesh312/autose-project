+    def _validate_trans_variables(
+        self,
+        variables: t.Dict[str, nodes.Expr],
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate the names and expressions of all variables used in a
+        translation block.
+        """
+        for name, expr in variables.items():
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r}: variable names must be "
+                    "valid Python identifiers",
+                    lineno,
+                )
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation "
+                    f"function names: {', '.join(GETTEXT_FUNCTIONS)}",
+                    lineno,
+                )
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self,
+        name: str,
+        expr: nodes.Expr,
+        parser: "Parser",
+        lineno: int,
+    ) -> None:
+        """Validate a single expression used as a translatable variable.
+        """
+        if isinstance(expr, nodes.Call):
+            if isinstance(expr.node, nodes.Name):
+                return
+        elif isinstance(expr, self._allowed_trans_expr_types):
+            return
+        node_type = expr.__class__.__name__
+        parser.fail(
+            f"Invalid expression for variable {name!r}: {node_type} contains "
+            "template data or is a complex nested expression that cannot "
+            "be used in translation contexts",
+            lineno,
+        )
+
     def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
         return _ws_re.sub(" ", string.strip())
 
