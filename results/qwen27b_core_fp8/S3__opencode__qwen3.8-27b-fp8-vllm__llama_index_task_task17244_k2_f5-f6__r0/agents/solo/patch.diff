+    def get_image_mimetype(self) -> Optional[str]:
+        """Get the image's mimetype, lazily resolving and caching it.
+
+        If the mimetype is already set, it is returned as-is. Otherwise, it is
+        guessed using the ``filetype`` library (when image data is available)
+        and cached for future accesses.
+
+        Returns:
+            The mimetype of the image, or ``None`` if it could not be
+            determined.
+        """
