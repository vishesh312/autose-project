+    def _validate_trans_variables(
+        self,
+        variables: t.Dict[str, nodes.Expr],
+        parser: "Parser",
+        lineno: t.Optional[int],
+    ) -> None:
+        """Validate all variables used in a translation block.
+
+        Variable names must be valid Python identifiers and must not
+        clash with the translation functions provided by the i18n
+        extension.  The expression assigned to every variable is
+        checked as well.
+        """
+        for name, expr in variables.items():
+            if not isinstance(name, str) or not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r} in translation block: "
+                    f"translation variable names must be valid Python "
+                    f"identifiers.",
+                    lineno,
+                )
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation "
+                    f"function names and cannot be used as a translation "
+                    f"variable.",
+                    lineno,
+                )
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self,
+        name: str,
+        expr: nodes.Expr,
+        parser: "Parser",
+        lineno: t.Optional[int],
+    ) -> None:
+        """Validate a single expression used in a translation block.
+
+        Only expressions that can be safely evaluated and substituted
+        in translation contexts are allowed.
+        """
+        if isinstance(expr, (nodes.TemplateData, nodes.Output)):
+            parser.fail(
+                f"Invalid expression for variable {name!r}: template data "
+                f"cannot be used in translation contexts.",
+                lineno,
+            )
+        if isinstance(expr, nodes.Call) and not isinstance(expr.node, nodes.Name):
+            parser.fail(
+                f"Invalid expression for variable {name!r}: only simple "
+                f"function calls are allowed, complex template data "
+                f"expressions cannot be used in translation contexts.",
+                lineno,
+            )
+        if not isinstance(
+            expr,
+            (
+                nodes.Const,
+                nodes.Name,
+                nodes.Call,
+                nodes.Getattr,
+                nodes.Filter,
+                nodes.Test,
+            ),
+        ):
+            parser.fail(
+                f"Invalid expression for variable {name!r}: complex nested "
+                f"expressions involving template data cannot be serialized "
+                f"for translation contexts.",
+                lineno,
+            )
+
