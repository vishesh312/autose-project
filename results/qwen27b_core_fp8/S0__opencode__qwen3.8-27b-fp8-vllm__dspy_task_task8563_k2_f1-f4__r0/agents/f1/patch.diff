+TOOL_CALLS_VALIDATE_INPUT_CASES = [
+    (
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+    ),
+    (
+        {"name": "search", "args": {"query": "hello"}},
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+    ),
+    (
+        [{"name": "search", "args": {"query": "hello"}}, {"name": "translate", "args": {"text": "world"}}],
+        {
+            "tool_calls": [
+                {"name": "search", "args": {"query": "hello"}},
+                {"name": "translate", "args": {"text": "world"}},
+            ]
+        },
+    ),
+    (
+        json.dumps({"tool_calls": [{"name": "search", "args": {"query": "hello"}}]}),
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+    ),
+    (
+        json.dumps({"name": "search", "args": {"query": "hello"}}),
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+    ),
+    (
+        json.dumps([{"name": "search", "args": {"query": "hello"}}]),
+        {"tool_calls": [{"name": "search", "args": {"query": "hello"}}]},
+    ),
+    ("not a json string", "not a json string"),
+]
