+    @model_validator(mode="before")
+    @classmethod
+    def validate_input(cls, data: Any):
+        """Normalize the input to the canonical `{"tool_calls": [...]}` format.
+
+        LMs may return tool calls in different formats:
+        1. Canonical: `{"tool_calls": [{"name": ..., "args": ...}, ...]}`
+        2. A single tool call object: `{"name": ..., "args": ...}`
+        3. A bare list of tool call objects: `[{"name": ..., "args": ...}, ...]`
+        4. A JSON string of any of the above.
+
+        All of these are normalized into the canonical format so that the model can be constructed.
+        """
+        if isinstance(data, cls):
+            return {"tool_calls": [tool_call.model_dump() for tool_call in data.tool_calls]}
+
+        if isinstance(data, str):
+            try:
+                data = json.loads(data)
+            except json.JSONDecodeError:
+                # Return the original string unchanged if it is not a valid JSON string.
+                return data
+
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                return data
+            if "name" in data and "args" in data:
+                # Wrap a single tool call object into a list under the `tool_calls` key.
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list):
+            # Wrap a bare list of tool call objects into the `tool_calls` key.
+            return {"tool_calls": data}
+
+        return data
+
