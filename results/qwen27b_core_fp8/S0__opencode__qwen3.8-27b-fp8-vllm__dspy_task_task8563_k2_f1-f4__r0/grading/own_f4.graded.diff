+def _canonicalize_tool_call_args(args: Any) -> Any:
+    """Recursively canonicalize tool call arguments for stable fingerprinting.
+
+    Dict keys are sorted recursively, tuples are converted to lists, and leading/trailing whitespace is
+    stripped from string values. Numeric and boolean values are preserved as-is, so no semantic type
+    coercion is performed.
+    """
+    if isinstance(args, dict):
+        return {key: _canonicalize_tool_call_args(value) for key, value in sorted(args.items())}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_tool_call_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
+
 class ToolCalls(Type):
     class ToolCall(BaseModel):
         name: str
         args: dict[str, Any]
+        fingerprint: str = ""
+        id: str = ""
+
+        def __init__(self, **data: Any) -> None:
+            super().__init__(**data)
+            canonical = {"name": self.name, "args": _canonicalize_tool_call_args(self.args)}
+            payload = json.dumps(canonical, sort_keys=True, separators=(",", ":"))
+            self.fingerprint = hashlib.sha256(payload.encode("utf-8")).hexdigest()
+            self.id = self.fingerprint[:8]
 
     tool_calls: list[ToolCall]
 
