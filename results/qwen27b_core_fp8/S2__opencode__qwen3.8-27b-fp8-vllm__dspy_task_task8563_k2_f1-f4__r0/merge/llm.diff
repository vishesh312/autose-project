+def _canonicalize_args(args: Any) -> Any:
+    """Recursively canonicalize tool call args for fingerprinting.
+
+    Dict keys are sorted, tuples are converted to lists, and surrounding whitespace is stripped from string
+    values. Numbers, booleans, and all other values are left unchanged, so the semantics of the args are
+    preserved.
+    """
+    if isinstance(args, dict):
+        return {key: _canonicalize_args(args[key]) for key in sorted(args)}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
+
+def _compute_tool_call_fingerprint(name: str, args: dict[str, Any]) -> str:
+    """Compute the SHA-256 fingerprint of a tool call from its name and canonicalized args."""
+    canonical = {"name": name, "args": _canonicalize_args(args)}
+    serialized = json.dumps(canonical, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
