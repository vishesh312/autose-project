+def _canonicalize_args(value: Any) -> Any:
+    """Recursively canonicalize a value for stable fingerprinting.
+
+    Dict keys are sorted, tuples are converted to lists, and leading/trailing whitespace is stripped from
+    string values. Numbers, booleans, and other values are returned unchanged, so semantics are preserved.
+    """
+    if isinstance(value, dict):
+        return {key: _canonicalize_args(val) for key, val in sorted(value.items(), key=lambda item: str(item[0]))}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize_args(item) for item in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
