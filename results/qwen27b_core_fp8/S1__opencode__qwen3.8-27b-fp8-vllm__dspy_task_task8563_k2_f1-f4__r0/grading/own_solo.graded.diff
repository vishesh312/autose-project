+def _canonicalize_tool_call_args(args: Any) -> Any:
+    """Recursively canonicalize tool call arguments for stable fingerprinting.
+
+    - Sorts the keys of every dict.
+    - Converts tuples to lists.
+    - Strips leading/trailing whitespace from string values.
+    - Leaves all other values (numbers, booleans, None, ...) unchanged, so their
+      types are preserved.
+    """
+    if isinstance(args, dict):
+        try:
+            keys = sorted(args.keys())
+        except TypeError:
+            # Fall back to string-based ordering when keys are not mutually comparable.
+            keys = sorted(args.keys(), key=str)
+        return {key: _canonicalize_tool_call_args(args[key]) for key in keys}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_tool_call_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
