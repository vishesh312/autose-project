+def _close_exit_stack(stack: ExitStack) -> None:
+    """Close an :class:`ExitStack` in a worker thread. Errors are
+    logged instead of propagated, because an exception raised in a
+    worker thread would otherwise be silently lost.
+    """
+    try:
+        stack.close()
+    except Exception:
+        import logging
+
+        logging.getLogger(__name__).exception("Error during context cleanup.")
