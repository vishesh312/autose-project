+def _canonicalize(value: Any) -> Any:
+    """Recursively canonicalize a JSON-compatible value.
+
+    Dict keys are sorted, tuples are converted to lists, and surrounding
+    whitespace is stripped from strings. Numbers and booleans are preserved
+    as-is, so no semantics are changed.
+    """
+    if isinstance(value, dict):
+        return {key: _canonicalize(item) for key, item in sorted(value.items())}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize(item) for item in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
