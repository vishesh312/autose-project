+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Make ``alias`` resolve to ``target`` when a template is looked
+        up.  The alias is resolved before the normal template lookup and
+        is not followed recursively: if ``target`` is itself an alias it
+        is not resolved further.  Calling this again with the same alias
+        replaces the previous target.
+        """
+        self._aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove a previously added alias.  Does nothing if the alias
+        does not exist.
+        """
+        self._aliases.pop(alias, None)
+
+    def _prepare_template(self, template: str) -> t.Tuple[str, str]:
+        """Resolve the alias for ``template`` and apply the path
+        transform, if any.  Returns a ``(name, resolved)`` tuple where
+        ``name`` is the template name to report in errors and ``resolved``
+        is the name that is actually looked up.
+        """
+        template = self._aliases.get(template, template)
+        name = template
+        if self._path_transform is not None:
+            template = self._path_transform(template)
+        return name, template
+
