@@ -0,0 +1,11 @@
+import re
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Lowercase text, replace non-ASCII alphanumeric runs with sep, and strip leading/trailing sep."""
+    lowered = text.lower()
+    # Replace runs of characters that are not ASCII letters or digits with sep
+    replaced = re.sub(r"[^a-z0-9]+", sep, lowered)
+    if sep:
+        return replaced.strip(sep)
+    return replaced
