ile mode 100644\r\nindex 0000000..1ebefa0\r\n--- /dev/null\r\n+++ b/textkit/__init__.py\r\n@@ -0,0 +1,3 @@\r\n+\"\"\"textkit: tiny text statistics.\"\"\"\r\n+\r\n+__version__ = \"0.1.0\"\r\ndiff --git a/textkit/cli.py b/textkit/cli.py\r\nnew file mode 100644\r\nindex 0000000..7cd1c65\r\n--- /dev/null\r\n+++ b/textkit/cli.py\r\n@@ -0,0 +1,22 @@\r\n+\"\"\"Command line interface: textkit OP FILE\"\"\"\r\n+\r\n+import argparse\r\n+import sys\r\n+\r\n+from .core import OPERATIONS, run\r\n+\r\n+\r\n+def main(argv=None) -\u003e int:\r\n+    parser = argparse.ArgumentParser(prog=\"textkit\")\r\n+    parser.add_argument(\"op\", choices=sorted(OPERATIONS))\r\n+    parser.add_argument(\"file\")\r\n+    args = parser.parse_args(argv)\r\n+    with open(args.file) as fh:\r\n+        text = fh.read()\r\n+    result = run(args.op, text)\r\n+    print(result)\r\n+    return 0\r\n+\r\n+\r\n+if __name__ == \"__main__\":\r\n+    sys.exit(main())\r\ndiff --git a/textkit/core.py b/textkit/core.py\r\nnew file mode 100644\r\nindex 0000000..af4b9bf\r\n--- /dev/null\r\n+++ b/textkit/core.py\r\n@@ -0,0 +1,24 @@\r\n+\"\"\"Core text operations.\"\"\"\r\n+\r\n+\r\n+def word_count(text: str) -\u003e int:\r\n+    \"\"\"Number of whitespace-separated words.\"\"\"\r\n+    return len(text.split())\r\n+\r\n+\r\n+def char_count(text: str) -\u003e int:\r\n+    \"\"\"Number of characters, including whitespace.\"\"\"\r\n+    return len(text)\r\n+\r\n+\r\n+OPERATIONS = {\r\n+    \"words\": word_count,\r\n+    \"chars\": char_count,\r\n+}\r\n+\r\n+\r\n+def run(op: str, text: str):\r\n+    \"\"\"Apply the named operation to text.\"\"\"\r\n+    if op not in OPERATIONS:\r\n+        raise KeyError(f\"unknown operation: {op}\")\r\n+    return OPERATIONS[op](text)\r\n"}}}
