{"name": "write", "kind": "edit", "args": {"content": "from outlines.types import octal_str\nfrom pydantic import BaseModel, ValidationError\n\n# Test cases\nvalid_cases = [\n    ('0o755', True),\n    ('0o123', True),\n]\n\ninvalid_cases = [\n    ('755', False),\n    ('0o756', False),\n    ('0o800', False),\n    ('0o75x', False),\n]\n\n\nclass FilePermission(BaseModel):\n    mode: octal_str\n\n# Test valid cases\nfor case, expected in valid_cases:\n    try:\n        perm = FilePermission(mode=case)\n        assert perm.mode == case\n    except ValidationError as e:\n        print(f'Validation failed for {case}: {e}')\n\n# Test invalid cases\nfor case, expected in invalid_cases:\n    try:\n        perm = FilePermission(mode=case)\n        assert False, f'Validation should have failed for {case}'\n    except ValidationError as e:\n        pass\n", "filePath": "/tmp/parbench-host-d5jyqqao/repo/tests/types/test_octal_str.py"}, "ok": true, "ts": null}
