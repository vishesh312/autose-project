diff --git a/tests/types/test_octal_str.py b/tests/types/test_octal_str.py
new file mode 100644
index 0000000..94d090d
--- /dev/null
+++ b/tests/types/test_octal_str.py
@@ -0,0 +1,35 @@
+from outlines.types import octal_str
+from pydantic import BaseModel, ValidationError
+
+# Test cases
+valid_cases = [
+    ('0o755', True),
+    ('0o123', True),
+]
+
+invalid_cases = [
+    ('755', False),
+    ('0o756', False),
+    ('0o800', False),
+    ('0o75x', False),
+]
+
+
+class FilePermission(BaseModel):
+    mode: octal_str
+
+# Test valid cases
+for case, expected in valid_cases:
+    try:
+        perm = FilePermission(mode=case)
+        assert perm.mode == case
+    except ValidationError as e:
+        print(f'Validation failed for {case}: {e}')
+
+# Test invalid cases
+for case, expected in invalid_cases:
+    try:
+        perm = FilePermission(mode=case)
+        assert False, f'Validation should have failed for {case}'
+    except ValidationError as e:
+        pass
