+            return
+
+        exit_stack, self._exit_stack = self._exit_stack, ExitStack()
+
+        def _run_cleanup() -> None:
+            exit_stack.close()
+
+        thread = threading.Thread(target=_run_cleanup, daemon=True)
+        thread.start()
+        thread.join(self.cleanup_timeout)
+
+        if thread.is_alive():
+            import logging
+
+            logging.getLogger("click").warning(
+                "Cleanup timed out after %s seconds", self.cleanup_timeout
+            )
 
