+def _canonicalize_for_fingerprint(value: Any) -> Any:
+    """Recursively canonicalize a value for stable fingerprinting.
+
+    - Sorts dict keys recursively.
+    - Converts tuples to lists.
+    - Strips leading/trailing whitespace from string values.
+    - Leaves numeric and boolean values unchanged (no type coercion).
+    """
+    if isinstance(value, dict):
+        return {k: _canonicalize_for_fingerprint(v) for k, v in sorted(value.items(), key=lambda kv: str(kv[0]))}
+    if isinstance(value, (list, tuple)):
+        return [_canonicalize_for_fingerprint(item) for item in value]
+    if isinstance(value, str):
+        return value.strip()
+    return value
+
