+def _canonicalize_args(args: Any) -> Any:
+    """Recursively canonicalize args: sort dict keys, convert tuples to lists, trim string whitespace."""
+    if isinstance(args, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(args.items())}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
