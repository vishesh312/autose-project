+def _canonicalize_args(args: Any) -> Any:
+    """Recursively canonicalize tool call arguments for stable fingerprinting.
+
+    - Sorts dict keys recursively.
+    - Converts tuples to lists for consistency.
+    - Strips leading/trailing whitespace from string values.
+    - Leaves numeric, boolean, and ``None`` values unchanged (no type coercion).
+    """
+    if isinstance(args, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(args.items())}
+    if isinstance(args, (list, tuple)):
+        return [_canonicalize_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
