         """Invoke all close callbacks registered with
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
+
+        If :attr:`cleanup_timeout` is set and the cleanup operations
+        do not finish within the given number of seconds, they are
+        forcibly stopped and a warning is logged.
         """
-        self._exit_stack.close()
+        if self.cleanup_timeout is None:
+            self._exit_stack.close()
+        else:
+            import logging
+            import threading
+
+            result: dict[str, BaseException | None] = {}
+
+            def run_close() -> None:
+                try:
+                    self._exit_stack.close()
+                except BaseException as e:  # noqa: BLE001
+                    result["error"] = e
+
+            worker = threading.Thread(target=run_close, daemon=True)
+            worker.start()
+            worker.join(self.cleanup_timeout)
+
+            if worker.is_alive():
+                logging.getLogger("click").warning(
+                    "Context cleanup did not complete within %s seconds,"
+                    " the cleanup operations were abandoned.",
+                    self.cleanup_timeout,
+                )
+            elif result.get("error") is not None:
+                raise result["error"]
+
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
 
