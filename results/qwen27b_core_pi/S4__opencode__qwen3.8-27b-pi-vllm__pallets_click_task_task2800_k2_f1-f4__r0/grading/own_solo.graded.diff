@@ -427,6 +431,12 @@ class Context:
         #: Show option default values when formatting help text.
         self.show_default: bool | None = show_default
 
+        if cleanup_timeout is not None and cleanup_timeout <= 0:
+            raise ValueError("cleanup_timeout must be a positive float value")
+
+        #: Timeout in seconds for cleanup operations during close().
+        self.cleanup_timeout: float | None = cleanup_timeout
+
         self._close_callbacks: list[t.Callable[[], t.Any]] = []
         self._depth = 0
         self._parameter_source: dict[str, ParameterSource] = {}
@@ -607,7 +617,32 @@ class Context:
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
         """
-        self._exit_stack.close()
+        if self.cleanup_timeout is not None:
+            import logging
+            import threading
+
+            exceptions: list[BaseException] = []
+
+            def _do_close() -> None:
+                try:
+                    self._exit_stack.close()
+                except BaseException as e:  # noqa: BLE001
+                    exceptions.append(e)
+
+            thread = threading.Thread(target=_do_close, daemon=True)
+            thread.start()
+            thread.join(timeout=self.cleanup_timeout)
+
+            if thread.is_alive():
+                logging.getLogger(__name__).warning(
+                    "Context close() timed out after %s seconds. "
+                    "Cleanup operations were forcibly terminated.",
+                    self.cleanup_timeout,
+                )
+            elif exceptions:
+                raise exceptions[0]
+        else:
+            self._exit_stack.close()
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
 
