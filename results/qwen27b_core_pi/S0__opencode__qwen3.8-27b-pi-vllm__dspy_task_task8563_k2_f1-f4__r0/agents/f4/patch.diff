+def _canonicalize_args(args: Any) -> Any:
+    """Recursively canonicalize args for fingerprinting.
+
+    Sorts dict keys, converts tuples to lists, and trims leading/trailing
+    whitespace from string values. Numeric and boolean types are preserved.
+    """
+    if isinstance(args, dict):
+        return {k: _canonicalize_args(v) for k, v in sorted(args.items(), key=lambda item: str(item[0]))}
+    if isinstance(args, tuple):
+        return [_canonicalize_args(item) for item in args]
+    if isinstance(args, list):
+        return [_canonicalize_args(item) for item in args]
+    if isinstance(args, str):
+        return args.strip()
+    return args
+
