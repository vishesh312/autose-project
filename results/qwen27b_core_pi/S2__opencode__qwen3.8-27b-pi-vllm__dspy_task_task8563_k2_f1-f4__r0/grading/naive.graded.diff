+def _parse_json_lenient(data: str) -> Any:
+    """Parse a JSON string, falling back to ``json_repair`` for slightly malformed input.
+
+    Returns the parsed object (dict/list/str/etc.), or the original string unchanged if it
+    cannot be parsed into a JSON structure.
+    """
+    try:
+        return json.loads(data)
+    except (json.JSONDecodeError, ValueError):
+        pass
+    try:
+        repaired = json_repair.loads(data)
+    except Exception:
+        return data
+    # ``json_repair`` may return a plain string for non-JSON input (e.g. ""); only accept
+    # dict/list results as meaningful JSON structures, otherwise treat as unparseable.
+    if isinstance(repaired, (dict, list)):
+        return repaired
+    return data
+
