+    def validate_input(cls, data: Any) -> Any:
+        """Normalize the various tool-call formats LMs may emit into the canonical structure.
+
+        LMs frequently return tool calls in shapes that deviate from the expected
+        ``{"tool_calls": [...]}`` container. This normalizes them so downstream tool
+        execution can rely on a single internal format:
+
+        - A dict that already contains a ``tool_calls`` key is returned unchanged.
+        - A single ``{"name": ..., "args": ...}`` object (with no ``tool_calls`` key)
+          is wrapped into ``{"tool_calls": [obj]}``.
+        - A list of ``{"name": ..., "args": ...}`` objects is wrapped into
+          ``{"tool_calls": [...]}``.
+        - A JSON string is parsed first and then normalized using the rules above.
+        - A non-JSON string that cannot be parsed is returned unchanged.
+
+        Returns a normalized Python structure (dict/list/str), not a ``ToolCalls``
+        instance.
+        """
+        if isinstance(data, cls):
+            return data
+
+        if isinstance(data, str):
+            parsed = _parse_json_lenient(data)
+            if parsed is data:
+                # Not parseable as a JSON structure; return the original string unchanged.
+                return data
+            data = parsed
+
+        if isinstance(data, dict):
+            if "tool_calls" in data:
+                # Existing behavior preserved.
+                return data
+            if "name" in data and "args" in data:
+                # Single-object normalization: wrap into the canonical container.
+                return {"tool_calls": [data]}
+            return data
+
+        if isinstance(data, list):
+            # List normalization: wrap the list in the canonical container.
+            return {"tool_calls": data}
+
+        return data
+
