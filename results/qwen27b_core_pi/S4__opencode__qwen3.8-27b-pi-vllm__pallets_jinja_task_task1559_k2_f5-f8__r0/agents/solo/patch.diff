+    def _validate_trans_variables(
+        self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int
+    ) -> None:
+        """Validate all variables used in a translation block."""
+        for name, expr in variables.items():
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r} in translation block: "
+                    "translation variable names must be valid Python identifiers.",
+                    lineno,
+                )
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function "
+                    "names such as gettext, ngettext, pgettext, npgettext, _.",
+                    lineno,
+                )
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self, name: str, expr: nodes.Expr, parser: "Parser", lineno: int
+    ) -> None:
+        """Validate a single translation variable expression."""
+        allowed_types = (
+            nodes.Const,
+            nodes.Name,
+            nodes.Getattr,
+            nodes.Filter,
+            nodes.Test,
+        )
+        if isinstance(expr, nodes.Call):
+            if not isinstance(expr.node, nodes.Name):
+                parser.fail(
+                    f"Variable {name!r} uses template data or an unsupported "
+                    "expression which cannot be used in translation contexts: "
+                    "only simple function calls are allowed.",
+                    lineno,
+                )
+        elif isinstance(expr, (nodes.TemplateData, nodes.Output)):
+            parser.fail(
+                f"Variable {name!r} uses template data which cannot be "
+                "serialized and is therefore not allowed in translation contexts.",
+                lineno,
+            )
+        elif not isinstance(expr, allowed_types):
+            parser.fail(
+                f"Variable {name!r} uses template data or a complex nested "
+                "expression which cannot be serialized and is therefore not "
+                "allowed in translation contexts.",
+                lineno,
+            )
