+
+    def remove_alias(self, alias: str) -> None:
+        """Remove a previously registered alias.
+
+        Safe to call for an alias that was never registered; no error is
+        raised in that case.
+        """
+        self._alias_map.pop(alias, None)
+
+    def _resolve_alias(self, template: str) -> str:
+        """Map ``template`` to its alias target if one is registered.
+
+        Resolution is a single step: aliases do not chain, so a target
+        that is itself an alias is returned as-is.
+        """
+        return self._alias_map.get(template, template)
