+    def add_alias(self, alias: str, target: str) -> None:
+        """Register ``alias`` as an alternate name for ``target``.
+
+        Loading a template by ``alias`` is identical to loading
+        ``target``.  Calling this again with the same ``alias`` overwrites
+        the previous mapping.
+        """
