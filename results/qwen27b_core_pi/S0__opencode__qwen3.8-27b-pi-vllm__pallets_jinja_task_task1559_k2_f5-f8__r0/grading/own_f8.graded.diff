+class ConditionalI18nExtension(Extension):
+    """Adds a ``ctrans`` tag that conditionally renders translations based on a
+    runtime boolean condition, with a mandatory fallback block.
+
+    .. code-block:: html+jinja
+
+        {% ctrans use_i18n count name %}
+            Hello {{ name }}! You have {{ count }} item.
+        {% pluralize count %}
+            Hello {{ name }}! You have {{ count }} items.
+        {% fallback %}
+            Hi {{ name }}!
+        {% endctrans %}
+
+    When ``use_i18n`` is true the translation path (``gettext``/``ngettext``)
+    is rendered, otherwise the fallback content is rendered directly with
+    variable substitution.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.If:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+
+        # The first expression in the header is the runtime condition that
+        # decides between the translation path and the fallback.
+        condition = parser.parse_expression()
+
+        # Parse optional variable declarations and trimming modifiers. Commas
+        # are optional separators anywhere in the header.
+        plural_expr: t.Optional[nodes.Expr] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed: t.Optional[bool] = None
+        while parser.stream.current.type != "block_end":
+            # commas are optional separators
+            parser.stream.skip_if("comma")
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+            if parser.stream.current.type == "block_end":
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                var: nodes.Expr = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                var = nodes.Name(token.value, "load")
+
+            variables[token.value] = var
+
+            if plural_expr is None:
+                plural_expr = var
+
+        parser.stream.expect("block_end")
+
+        # Parse the singular (translatable) content block.
+        singular_names, singular = self._parse_block(
+            parser, ("pluralize", "fallback", "endctrans")
+        )
+        referenced = set(singular_names)
+        if plural_expr is None and singular_names:
+            plural_expr = nodes.Name(singular_names[0], "load")
+
+        # Optionally parse the pluralize block.
+        have_plural = False
+        plural: t.Optional[str] = None
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)  # consume the 'pluralize' name
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, ("fallback", "endctrans"))
+            referenced.update(plural_names)
+
+        # The fallback block is mandatory.
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail(
+                "expected 'fallback' block",
+                parser.stream.current.lineno,
+                exc=TemplateSyntaxError,
+            )
+
+        next(parser.stream)  # consume the 'fallback' name
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, ("endctrans",))
+        referenced.update(fallback_names)
+
+        # Consume the 'endctrans' name, leaving the block_end for the parser.
+        parser.stream.expect("name:endctrans")
+
+        # Register free names as simple name expressions.
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition, singular, plural, fallback, variables, plural_expr,
+            bool(referenced),
+        )
+        node.set_lineno(lineno)
+        return node
+
+    def _parse_block(
+        self, parser: "Parser", stop_names: t.Tuple[str, ...]
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next block tag whose name is in `stop_names`.
+
+        The parser stream is left pointing at the stop-name token (the
+        ``block_begin`` is consumed but the name is not). Returns a tuple of
+        the referenced variable names and the accumulated block content.
+        """
+        referenced: t.List[str] = []
+        buf: t.List[str] = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                tok = parser.stream.current
+                if tok.type == "name" and tok.value in stop_names:
+                    break
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        vars_referenced: bool,
+    ) -> nodes.If:
+        """Generates an :class:`~jinja2.nodes.If` node that renders the
+        translation when ``condition`` is true and the fallback otherwise.
+        """
+        newstyle = bool(getattr(self.environment, "newstyle_gettext", False))
+
+        # No variables referenced? No need to escape for old style gettext
+        # invocations only if there are vars.
+        if not vars_referenced and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+            fallback = fallback.replace("%%", "%")
+
+        # --- translation path (condition true) ---
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            call_node = nodes.Call(
+                gettext, [nodes.Const(singular)], [], None, None
+            )
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            call_node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        trans_node: nodes.Expr
+        if newstyle:
+            for key, value in variables.items():
+                call_node.kwargs.append(nodes.Keyword(key, value))
+            trans_node = call_node
+        else:
+            # mark the return value as safe if we are in an environment
+            # with autoescaping turned on
+            trans_node = nodes.MarkSafeIfAutoescape(call_node)
+            if variables:
+                trans_node = nodes.Mod(
+                    trans_node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+
+        body = [nodes.Output([trans_node])]
+
+        # --- fallback path (condition false) ---
+        fb_node: nodes.Expr = nodes.Const(fallback)
+        if variables:
+            fb_node = nodes.Mod(
+                fb_node,
+                nodes.Dict(
+                    [
+                        nodes.Pair(nodes.Const(key), value)
+                        for key, value in variables.items()
+                    ]
+                ),
+            )
+
+        else_ = [nodes.Output([fb_node])]
+
+        return nodes.If(condition, body, [], else_)
+
+
