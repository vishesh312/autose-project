+    def _validate_trans_variables(
+        self, variables: t.Dict[str, nodes.Expr], parser: "Parser", lineno: int
+    ) -> None:
+        """Validate all variables in a translation block."""
+        for name, expr in variables.items():
+            if not name.isidentifier():
+                parser.fail(
+                    f"Invalid variable name {name!r} in trans block. "
+                    "Variable names must be valid Python identifiers.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            if name in GETTEXT_FUNCTIONS:
+                parser.fail(
+                    f"Variable name {name!r} conflicts with translation function names.",
+                    lineno,
+                    exc=TemplateSyntaxError,
+                )
+            self._validate_trans_expression(name, expr, parser, lineno)
+
+    def _validate_trans_expression(
+        self, name: str, expr: nodes.Expr, parser: "Parser", lineno: int
+    ) -> None:
+        """Validate a single expression used in a translation block."""
+        allowed_types = (
+            nodes.Const,
+            nodes.Name,
+            nodes.Call,
+            nodes.Getattr,
+            nodes.Filter,
+            nodes.Test,
+        )
+        if isinstance(expr, allowed_types):
+            return
+        if isinstance(expr, (nodes.TemplateData, nodes.Output)):
+            parser.fail(
+                f"Variable {name!r} uses template data which is not valid "
+                "for translation contexts.",
+                lineno,
+                exc=TemplateSyntaxError,
+            )
+        parser.fail(
+            f"Variable {name!r} uses a complex expression that cannot be "
+            "serialized for translation contexts.",
+            lineno,
+            exc=TemplateSyntaxError,
+        )
+
     def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
         return _ws_re.sub(" ", string.strip())
 
