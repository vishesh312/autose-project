+def _count_repeated_patterns(tokens: list[int]) -> dict[tuple[int, int], int]:
+    """Returns the top 3 most frequent adjacent token pairs with their occurrence counts."""
+    pair_counts: Counter[tuple[int, int]] = Counter(
+        (tokens[i], tokens[i + 1]) for i in range(len(tokens) - 1)
+    )
+    return dict(pair_counts.most_common(3))
