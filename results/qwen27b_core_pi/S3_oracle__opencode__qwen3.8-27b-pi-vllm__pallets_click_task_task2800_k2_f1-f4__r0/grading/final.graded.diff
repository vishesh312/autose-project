     .. versionchanged:: 8.2
         The ``protected_args`` attribute is deprecated and will be removed in
@@ -280,6 +286,7 @@ class Context:
         token_normalize_func: t.Callable[[str], str] | None = None,
         color: bool | None = None,
         show_default: bool | None = None,
+        cleanup_timeout: float | None = None,
     ) -> None:
         #: the parent context or `None` if none exists.
         self.parent = parent
@@ -427,6 +434,19 @@ class Context:
         #: Show option default values when formatting help text.
         self.show_default: bool | None = show_default
 
+        if cleanup_timeout is None and parent is not None:
+            cleanup_timeout = parent.cleanup_timeout
+
+        if cleanup_timeout is not None and cleanup_timeout <= 0:
+            raise ValueError(
+                f"cleanup_timeout must be a positive value, got {cleanup_timeout!r}."
+            )
+
+        #: The maximum time in seconds to wait for cleanup operations to
+        #: complete in :meth:`close`, or ``None`` for no timeout. When not
+        #: set explicitly, it is inherited from the parent context.
+        self.cleanup_timeout: float | None = cleanup_timeout
+
         self._close_callbacks: list[t.Callable[[], t.Any]] = []
         self._depth = 0
         self._parameter_source: dict[str, ParameterSource] = {}
@@ -606,8 +626,42 @@ class Context:
         """Invoke all close callbacks registered with
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
+
+        If a ``cleanup_timeout`` was set, the cleanup is performed in a
+        separate thread and interrupted once the timeout is exceeded, so
+        a hanging cleanup cannot block the process indefinitely. When the
+        timeout is hit a warning is logged and the pending cleanup is
+        abandoned; if the cleanup finished but raised, the error is
+        re-raised.
         """
-        self._exit_stack.close()
+        if self.cleanup_timeout is None:
+            self._exit_stack.close()
+        else:
+            import logging
+            import threading
+
+            exit_stack = self._exit_stack
+            errors: list[BaseException] = []
+
+            def run() -> None:
+                try:
+                    exit_stack.close()
+                except BaseException as e:  # noqa: BLE001
+                    errors.append(e)
+
+            worker = threading.Thread(target=run, daemon=True)
+            worker.start()
+            worker.join(self.cleanup_timeout)
+
+            if worker.is_alive():
+                logging.getLogger("click").warning(
+                    "Context cleanup timed out after %s seconds; aborting "
+                    "pending cleanup operations.",
+                    self.cleanup_timeout,
+                )
+            elif errors:
+                raise errors[0]
+
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
 
