+    ) -> None:
+        self._aliases: t.Dict[str, str] = {}
+        self._path_transform = path_transform
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Register an alias name that resolves to another template name.
+        Aliases do not chain: only one level of resolution is applied.
+        """
+        self._aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove a previously registered alias. Safe if the alias does
+        not exist.
+        """
+        self._aliases.pop(alias, None)
+
+    def resolve_alias(self, template: str) -> str:
+        """Resolve a single level of aliasing for a template name."""
+        return self._aliases.get(template, template)
+
+    def apply_path_transform(self, template: str) -> str:
+        """Apply the configured ``path_transform`` (if any) to a template
+        name.  The transform function receives exactly one string and must
+        return exactly one string; exceptions it raises propagate to the
+        caller.
+        """
+        if self._path_transform is not None:
+            return self._path_transform(template)
+        return template
+
