@@ -0,0 +1,42 @@
+import json
+import tempfile
+from textkit.cli import main
+from textkit.slug import slugify
+
+
+def test_slugify_basic():
+    assert slugify("  Hello, World!! ") == "hello-world"
+    assert slugify("A B", sep="_") == "a_b"
+    assert slugify("foo") == "foo"
+    assert slugify("Foo Bar Baz") == "foo-bar-baz"
+    assert slugify("") == ""
+    assert slugify("---") == ""
+    assert slugify("!@#$%^&*()") == ""
+    assert slugify("hello_world") == "hello-world"
+    assert slugify("123 456") == "123-456"
+
+
+def test_cli_json(capsys=None):
+    with tempfile.NamedTemporaryFile("w+", delete=True) as tf:
+        tf.write("one two three")
+        tf.flush()
+
+        import io
+        from contextlib import redirect_stdout
+
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(["words", tf.name])
+        assert buf.getvalue().strip() == "3"
+
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(["--json", "words", tf.name])
+        data = json.loads(buf.getvalue().strip())
+        assert data == {"op": "words", "result": 3}
+
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            main(["--json", "chars", tf.name])
+        data = json.loads(buf.getvalue().strip())
+        assert data == {"op": "chars", "result": 13}
