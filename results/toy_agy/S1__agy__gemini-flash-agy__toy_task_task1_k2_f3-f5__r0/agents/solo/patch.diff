@@ -0,0 +1,13 @@
+"""Slugify text helper."""
+
+import re
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Lowercase text, replace runs of non-ASCII-alphanumeric chars with sep, strip leading/trailing sep."""
+    lowered = text.lower()
+    replaced = re.sub(r"[^a-z0-9]+", sep, lowered)
+    if sep:
+        esc = re.escape(sep)
+        return re.sub(rf"^(?:{esc})+|(?:{esc})+$", "", replaced)
+    return replaced
