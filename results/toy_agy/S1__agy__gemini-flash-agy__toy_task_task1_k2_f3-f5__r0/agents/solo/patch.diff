@@ -0,0 +1,35 @@
+import json
+import tempfile
+from textkit.cli import main
+from textkit.slug import slugify
+
+
+def test_slugify():
+    assert slugify("  Hello, World!! ") == "hello-world"
+    assert slugify("A B", sep="_") == "a_b"
+    assert slugify("---Hello---World---") == "hello-world"
+    assert slugify("Hello 123 World") == "hello-123-world"
+    assert slugify("") == ""
+    assert slugify("!!!") == ""
+    assert slugify("A B", sep="--") == "a--b"
+
+
+def test_cli_json(capsys=None):
+    with tempfile.NamedTemporaryFile(mode="w", delete=False) as f:
+        f.write("one two three")
+        f_path = f.name
+
+    import io
+    import sys
+
+    old_stdout = sys.stdout
+    sys.stdout = io.StringIO()
+    try:
+        main(["words", f_path])
+        assert sys.stdout.getvalue().strip() == "3"
+
+        sys.stdout = io.StringIO()
+        main(["--json", "words", f_path])
+        assert json.loads(sys.stdout.getvalue()) == {"op": "words", "result": 3}
+    finally:
+        sys.stdout = old_stdout
