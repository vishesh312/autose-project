+from textkit.slug import slugify
+
+
+def test_slugify_basic():
+    assert slugify("  Hello, World!! ") == "hello-world"
+
+
+def test_slugify_custom_separator():
+    assert slugify("A B", sep="_") == "a_b"
+
+
+def test_slugify_empty_and_special_chars():
+    assert slugify("") == ""
+    assert slugify("   ") == ""
+    assert slugify("!@#$%^&*()") == ""
+
+
+def test_slugify_alphanumeric():
+    assert slugify("Item 123: 456 pieces") == "item-123-456-pieces"
+
+
+def test_slugify_repeated_separators():
+    assert slugify("---a---b---") == "a-b"
+
+
+def test_slugify_empty_sep():
+    assert slugify("Hello, World!", sep="") == "helloworld"
