+"""URL slug generation."""
+
+import re
+
+_NON_ALPHANUM_RE = re.compile(r"[^a-zA-Z0-9]+")
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Lowercase text and replace runs of non-alphanumeric ASCII characters with sep."""
+    lowered = text.lower()
+    replaced = _NON_ALPHANUM_RE.sub(sep, lowered)
+    if sep:
+        return replaced.strip(sep)
+    return replaced
