+"""Slugify helper."""
+
+import re
+
+
+def slugify(text: str, sep: str = "-") -> str:
+    """Lowercase text, replace non-alphanumeric runs with sep, and strip leading/trailing sep."""
+    words = re.findall(r"[a-zA-Z0-9]+", text.lower())
+    return sep.join(words)
