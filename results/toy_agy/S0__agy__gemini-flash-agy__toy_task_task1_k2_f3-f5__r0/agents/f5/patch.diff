+from textkit.slug import slugify
+
+
+def test_slugify_basic():
+    assert slugify("  Hello, World!! ") == "hello-world"
+
+
+def test_slugify_custom_separator():
+    assert slugify("A B", sep="_") == "a_b"
+
+
+def test_slugify_multiple_separators():
+    assert slugify("foo---bar...baz") == "foo-bar-baz"
+
+
+def test_slugify_numbers():
+    assert slugify("item 123 details 456") == "item-123-details-456"
+
+
+def test_slugify_empty_and_non_ascii():
+    assert slugify("") == ""
+    assert slugify("   !!!   ") == ""
+    assert slugify("---") == ""
+
+
+def test_slugify_separator_runs():
+    assert slugify("a...b///c", sep="/") == "a/b/c"
