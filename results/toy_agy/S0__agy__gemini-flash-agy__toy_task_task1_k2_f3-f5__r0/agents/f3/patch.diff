diff --git a/tests/test_cli.py b/tests/test_cli.py
new file mode 100644
index 0000000..531d9d2
--- /dev/null
+++ b/tests/test_cli.py
@@ -0,0 +1,27 @@
+import json
+from textkit.cli import main
+
+
+def test_cli_plain(tmp_path, capsys):
+    test_file = tmp_path / "sample.txt"
+    test_file.write_text("hello world from textkit")
+
+    ret = main(["words", str(test_file)])
+    assert ret == 0
+    captured = capsys.readouterr()
+    assert captured.out.strip() == "4"
+
+
+def test_cli_json(tmp_path, capsys):
+    test_file = tmp_path / "sample.txt"
+    test_file.write_text("hello world")
+
+    ret = main(["--json", "words", str(test_file)])
+    assert ret == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out.strip()) == {"op": "words", "result": 2}
+
+    ret = main(["chars", str(test_file), "--json"])
+    assert ret == 0
+    captured = capsys.readouterr()
+    assert json.loads(captured.out.strip()) == {"op": "chars", "result": 11}
